  "three_current_readings": [
    {
      "id": "A-KD6-QUEENSIDE-PREPARATION",
      "owned_scope": "Actual held10b work4 after Ke3 f6 Kf3, unrestricted d16 MultiPV3; Kd6/f5 tied returned leaders, Ke6 also returned.",
      "minimum_facts": [
        "Pc3xb4 is already legal before and after preparation; pawn recapture b2xc3 is also not newly legal.",
        "cxb4/cxb4/axb4 removes original Black Pb4/Pc5 and White Pc3, transforming original Pa3 into a b-file passer. Original Black Pc4/Pa4 can then break on c3/a3.",
        "Ke2/Kd2/Kc2 places the current king in time to meet the outside counter in the witnessed continuation; Pe4 may be conceded.",
        "The useful condition is timed interception with checks/counterplay priced, not exact Kd2 or King cycle recurrence."
      ],
      "actual_price": [
        "After ...c3, bxc3+ removes original Black Pc4 and checks Black Kd4.",
        "The forecast accepts ...Kxe4; Kb2 ...a3+ Kxa3 removes original Black Pa4."
      ],
      "falsifiers_and_unknown_closure": [
        "After first cxb4, ...c3+ and ...Kxe4 are legal alternatives to ...cxb4: the exchange is not forced.",
        "After bxc3+, Kc4/Ke3/Kxe4/Ke5 are legal. Only Kxe4 is this owned forecast.",
        "A different adequate king placement/checking breakthrough may make interception late or change the required price."
      ],
      "bounded_comment": "In this tested ...Kd6 continuation, king preparation makes the available queenside exchange usable by putting the king in time to meet the ensuing breakthrough; conceding the e-pawn can be part of that conversion.",
      "not_proved": "Forced exchange, all four later king replies losing, unique Kd2 route, or sole cause of original root judgment."
    },
    {
      "id": "B-F5-PASSER-CHECK-ROLE-TRANSFER",
      "owned_scope": "Actual held10b work4 ...f5 is a tied returned leader, not a weak off-main reply.",
      "minimum_facts": [
        "Original Pf7 goes to f5 and is captured by original Pe4. ...Kxf5 removes original Pe4.",
        "Retained Pg3 can now advance with check on Black Kf5. The opposing f-pawn has gone, so this pawn becomes a passer; king escort/current resistance still matter.",
        "Old Pe4 survival and the old waiting cycle are not invariants. The king and g-pawn take over the useful task."
      ],
      "actual_price": "...f5 exf5 Kxf5 g4+ Kg5 Kg3 ... followed by king activity/g5/Kxc5. Pe4/Pf7 exchange is an actual price.",
      "falsifiers_and_unknown_closure": [
        "After g4+, Ke5/Ke6/Kf6/Kg5/Kg6 are legal. Only Kg5 is this forecast.",
        "Check forces an evasion but neither one retreat nor a forced win. A central king reply may change escort timing/queenside activity.",
        "If Pg3 is unavailable or the current opponent can stop the passer/king task on better terms, narrow or withdraw this interpretation."
      ],
      "bounded_comment": "If Black resolves the central tension with ...f5, White can trade the e-pawn for that pawn and use the saved g-pawn as a checking passer, changing the earlier preparation plan.",
      "not_proved": "All five check evasions losing, saving Pg3 universally winning, Pe4 survival necessary, or complete original root causation."
    },
    {
      "id": "C-EARLY-G4-B3-BLOCKADE",
      "owned_scope": "Actual held10b work5 after Ke3 f6 g4; Ke6/b3/Kd6 tied returned leaders at0. Placement transposes to original g4 f6 Ke3; native owner stays separate.",
      "minimum_facts": [
        "Pb4-b3 removes the immediate b4 capture target and locks the queenside. White a3/c3 forward squares and b2 advance are occupied. Black b3 is guarded by Pa4/Pc4.",
        "Pg3 is already g4; g3-g4 cannot be spent again. Survival does not mean the reserve action remains available.",
        "In the later witness White Kf4 faces Black Ke6/Pf6: Kf5 is illegal through king opposition; g5 can be met by the f-pawn, and e5 permits ...fxe5+."
      ],
      "actual_price": "e5 ...fxe5+ removes original Pe4 and produces opposing passed-pawn counterplay; this forecast does not demonstrate White winning conversion.",
      "falsifiers_and_unknown_closure": [
        "b3 is not uniquely strongest: Ke6/Kd6 also return0 with different timings.",
        "A changed king placement or later justified exchange can alter the pawn task, so do not infer perpetual blockade from the move label.",
        "When legal, remaining ...f5 must be considered; noPawnMovesLeft is not a general requirement."
      ],
      "bounded_comment": "In the tested ...b3 defense the early advance leaves no second g3-g4 tempo, while the queenside stays locked; the central break costs the e-pawn and leaves counterplay.",
      "not_proved": "g4 useless against every reply, b3 uniquely strongest, every king entry impossible, or lack of one spare pawn move alone proving a draw."
    }
