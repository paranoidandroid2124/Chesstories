FROM node:24.12.0-trixie-slim AS ui-builder

WORKDIR /src

ENV CI=1
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN corepack enable

COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm --dir ui/.build install --ignore-workspace --frozen-lockfile
RUN rm -f ui/.build/instance.lock \
    && node --experimental-strip-types --no-warnings bin/build-openbeta-assets.mjs \
    && test -s public/npm/stockfish-web/sf_18_smallnet.js \
    && test -s public/npm/stockfish-web/sf_18_smallnet.wasm \
    && echo '4ca89e4b3abfbe9df13e4f3db2acb64dc6ddc7a9becb2ac1cf388f4d66b3bd94  public/lifat/nnue/nn-4ca89e4b3abf.nnue' | sha256sum -c -


FROM sbtscala/scala-sbt:eclipse-temurin-alpine-25_36_1.11.6_3.7.3 AS app-builder

WORKDIR /src

COPY . .
COPY --from=ui-builder /src/public ./public

RUN chmod +x ./lila.sh && ./lila.sh stage


FROM eclipse-temurin:25-jre-jammy AS runtime

WORKDIR /app

RUN useradd --create-home --shell /bin/bash appuser

COPY --from=app-builder /src/target/universal/stage /app
COPY --from=ui-builder /src/public /app/public
COPY --from=app-builder /src/conf/application.openbeta.conf /app/conf/application.openbeta.conf
COPY --from=app-builder /src/conf/openbeta-bindings.json /app/conf/openbeta-bindings.json
COPY --from=app-builder /src/conf/logger.openbeta.xml /app/conf/logger.openbeta.xml

RUN test -s /app/public/npm/stockfish-web/sf_18_smallnet.js \
    && test -s /app/public/npm/stockfish-web/sf_18_smallnet.wasm \
    && echo '4ca89e4b3abfbe9df13e4f3db2acb64dc6ddc7a9becb2ac1cf388f4d66b3bd94  /app/public/lifat/nnue/nn-4ca89e4b3abf.nnue' | sha256sum -c -

ENV JAVA_OPTS=""
ENV PORT=8080

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8080

ENTRYPOINT ["/bin/bash", "-lc", "exec /app/bin/lila -Dconfig.file=/app/conf/application.openbeta.conf -Dlogger.file=/app/conf/logger.openbeta.xml -Dhttp.address=0.0.0.0 -Dhttp.port=${PORT:-8080} ${JAVA_OPTS}"]
