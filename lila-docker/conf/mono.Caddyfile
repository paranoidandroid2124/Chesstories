:8080

encode zstd gzip
@engineNet path_regexp ^/assets/lifat/nnue/nn-[a-f0-9]{12}\.nnue$
header @engineNet Cache-Control "public, max-age=31536000, immutable"

handle_errors 502 {
	root * /static/errors
	rewrite * /502.html
	file_server
}

reverse_proxy :9663 {
	header_up Host {$CHESSTORY_DOMAIN}
	header_up Origin {$CHESSTORY_URL}
}
