{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/cause-audit-v3/open-world-adjudication.schema.json",
  "title": "Source-blind atomic Cause candidate adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partition",
    "arm_scope",
    "candidate_set_sha256",
    "source_blind",
    "statistics_unblinded",
    "decisions",
    "case_judgments"
  ],
  "properties": {
    "schema_version": {
      "const": "chesstory.eval.cause-audit-open-world-adjudication.v3"
    },
    "partition": {"enum": ["explore", "sealed_confirm"]},
    "arm_scope": {"const": "all_arms"},
    "candidate_set_sha256": {"$ref": "#/$defs/sha256"},
    "source_blind": {"const": true},
    "statistics_unblinded": {"const": false},
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/decision"}
    },
    "case_judgments": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/caseJudgment"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateId": {
      "type": "string",
      "pattern": "^ow:[0-9a-f]{64}$"
    },
    "casePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "meaning_ids",
        "meaning_ids_sha256",
        "priority"
      ],
      "properties": {
        "disposition": {"enum": ["answerable", "must_abstain", "unresolved"]},
        "meaning_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "oracle-label.schema.json#/$defs/id"}
        },
        "meaning_ids_sha256": {"$ref": "#/$defs/sha256"},
        "priority": {"$ref": "oracle-label.schema.json#/$defs/priority"}
      }
    },
    "caseJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "accepted_public_candidate_ids",
        "policy_sha256",
        "policy"
      ],
      "properties": {
        "case_id": {"$ref": "oracle-label.schema.json#/$defs/id"},
        "accepted_public_candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/candidateId"}
        },
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "policy": {"$ref": "#/$defs/casePolicy"}
      }
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id",
            "candidate_sha256",
            "decision",
            "verified_meaning",
            "verified_meaning_sha256"
          ],
          "properties": {
            "candidate_id": {"$ref": "#/$defs/candidateId"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "decision": {"const": "accepted"},
            "verified_meaning": {
              "$ref": "oracle-label.schema.json#/$defs/meaning"
            },
            "verified_meaning_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_id",
            "candidate_sha256",
            "decision",
            "verified_meaning",
            "verified_meaning_sha256"
          ],
          "properties": {
            "candidate_id": {"$ref": "#/$defs/candidateId"},
            "candidate_sha256": {"$ref": "#/$defs/sha256"},
            "decision": {"const": "rejected"},
            "verified_meaning": {"type": "null"},
            "verified_meaning_sha256": {"type": "null"}
          }
        }
      ]
    }
  }
}
