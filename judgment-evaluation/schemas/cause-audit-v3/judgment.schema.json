{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/cause-audit-v3/judgment.schema.json",
  "title": "Typed semantic Cause judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "partition",
    "disposition",
    "status",
    "endpoint_status",
    "oracle_label_sha256",
    "actual_view_sha256",
    "runtime_status",
    "semantic_assessment",
    "meaning_matches",
    "unmatched_generated_cause_ids",
    "unmatched_public_cause_ids",
    "priority",
    "cascade",
    "errors",
    "first_failure_stage"
  ],
  "properties": {
    "schema_version": {"const": "chesstory.eval.cause-audit-judgment.v3"},
    "case_id": {"$ref": "#/$defs/id"},
    "partition": {"enum": ["explore", "sealed_confirm"]},
    "disposition": {"enum": ["answerable", "must_abstain", "unresolved"]},
    "status": {
      "enum": [
        "matched",
        "mismatch",
        "must_abstain_pass",
        "unresolved",
        "runtime_unavailable"
      ]
    },
    "endpoint_status": {"enum": ["pass", "fail", "not_scored"]},
    "oracle_label_sha256": {"$ref": "#/$defs/sha256"},
    "actual_view_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_status": {"enum": ["complete", "unavailable", "adapter_error"]},
    "semantic_assessment": {"const": "typed-same-channel-exact"},
    "meaning_matches": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/meaningMatch"}
    },
    "unmatched_generated_cause_ids": {"$ref": "#/$defs/idSet"},
    "unmatched_public_cause_ids": {"$ref": "#/$defs/idSet"},
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "violations"],
      "properties": {
        "status": {"enum": ["matched", "mismatch", "not_scored"]},
        "violations": {
          "type": "array",
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/priorityViolation"}
        }
      }
    },
    "cascade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c", "jp", "ja", "r", "packet", "p"],
      "properties": {
        "c": {"type": "integer", "minimum": 0},
        "jp": {"type": "integer", "minimum": 0},
        "ja": {"type": "integer", "minimum": 0},
        "r": {"type": "integer", "minimum": 0},
        "packet": {"type": "integer", "minimum": 0},
        "p": {"type": "integer", "minimum": 0}
      }
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/error"}
    },
    "first_failure_stage": {
      "oneOf": [
        {"enum": ["C", "Jp", "Ja", "R", "P"]},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/id"}
    },
    "meaningMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning_id",
        "cause_evidence_id",
        "jp_survived",
        "ja_survived",
        "r_selected",
        "r_semantics_matched",
        "packet_selected",
        "public_selected"
      ],
      "properties": {
        "meaning_id": {"$ref": "#/$defs/id"},
        "cause_evidence_id": {"$ref": "#/$defs/id"},
        "jp_survived": {"type": "boolean"},
        "ja_survived": {"type": "boolean"},
        "r_selected": {"type": "boolean"},
        "r_semantics_matched": {"type": "boolean"},
        "packet_selected": {"type": "boolean"},
        "public_selected": {"type": "boolean"}
      }
    },
    "priorityViolation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "meaning_ids"],
          "properties": {
            "code": {"const": "tie_relation_mismatch"},
            "meaning_ids": {"$ref": "#/$defs/idSet"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "higher", "lower"],
          "properties": {
            "code": {"const": "importance_inversion"},
            "higher": {"$ref": "#/$defs/id"},
            "lower": {"$ref": "#/$defs/id"}
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage"],
      "properties": {
        "code": {
          "enum": [
            "runtime_unavailable",
            "missing_required_meaning",
            "cause_not_generated",
            "cause_admission_dropped",
            "forbidden_generated_meaning",
            "unmapped_generated_cause",
            "jp_loss",
            "ja_loss",
            "r_loss",
            "wrong_r_semantics",
            "forbidden_r_exposure",
            "wrong_exposure_tier",
            "dominated_fallback_exposed",
            "missing_top_r_selection",
            "tie_relation_mismatch",
            "importance_inversion",
            "importance_r_selection_set_mismatch",
            "importance_resolution_inconsistent",
            "importance_r_to_packet_mismatch",
                        "importance_packet_to_public_mismatch",
                        "idea_unit_r_to_packet_mismatch",
                        "idea_unit_packet_to_public_mismatch",
                        "idea_unit_membership_mismatch",
                        "idea_importance_r_to_packet_mismatch",
                        "idea_importance_packet_to_public_mismatch",
                        "cause_disposition_c_coverage_mismatch",
                        "cause_disposition_selection_mismatch",
                        "cause_disposition_r_to_packet_mismatch",
                        "cause_disposition_packet_to_public_mismatch",
                        "r_selection_set_mismatch",
            "r_to_packet_mismatch",
            "packet_to_public_mismatch",
            "public_idea_parse_mismatch",
            "public_id_set_mismatch",
            "unmapped_public_cause",
            "abstention_violation"
          ]
        },
        "stage": {"enum": ["C", "Jp", "Ja", "R", "P"]},
        "meaning_id": {"$ref": "#/$defs/id"},
        "cause_evidence_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
