{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/cause-audit-v3/open-world-arm-inventory.schema.json",
  "title": "Frozen all-arm typed Cause observation inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partition",
    "freeze_manifest_sha256",
    "cases_file_sha256",
    "base_oracle_file_sha256",
    "case_ids_sha256",
    "arms"
  ],
  "properties": {
    "schema_version": {
      "const": "chesstory.eval.cause-audit-open-world-arm-inventory.v3"
    },
    "partition": {"enum": ["explore", "sealed_confirm"]},
    "freeze_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "cases_file_sha256": {"$ref": "#/$defs/sha256"},
    "base_oracle_file_sha256": {"$ref": "#/$defs/sha256"},
    "case_ids_sha256": {"$ref": "#/$defs/sha256"},
    "arms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/arm"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "producerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_run_schema_version",
        "runtime_observation_schema",
        "adapter_main_class",
        "adapter_launcher_sha256",
        "engine_sha256",
        "candidate_binding_sha256"
      ],
      "properties": {
        "runtime_run_schema_version": {
          "const": "chesstory.eval.cause-audit-runtime-run.v1"
        },
        "runtime_observation_schema": {
          "const": "chesstory.cause-audit-runtime-observation.v3"
        },
        "adapter_main_class": {
          "const": "io.chesstory.evaluation.runtimeadapter.CauseAuditAdapterCli"
        },
        "adapter_launcher_sha256": {"$ref": "#/$defs/sha256"},
        "engine_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_binding_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c_semantics_sha256",
        "payload_sha256",
        "payload"
      ],
      "properties": {
        "c_semantics_sha256": {"$ref": "#/$defs/sha256"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "payload": {
          "$ref": "open-world-candidate-set.schema.json#/$defs/observationPayload"
        }
      }
    },
    "cascade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "actual_cascade_sha256",
        "observation_count",
        "unmatched_cause_observations"
      ],
      "properties": {
        "case_id": {"$ref": "oracle-label.schema.json#/$defs/id"},
        "actual_cascade_sha256": {"$ref": "#/$defs/sha256"},
        "observation_count": {"type": "integer", "minimum": 0},
        "unmatched_cause_observations": {
          "type": "array",
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/observation"}
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "runtime_run_file_sha256",
        "producer_contract_sha256",
        "producer_contract",
        "case_ids_sha256",
        "actual_cascades_sha256",
        "actual_cascades"
      ],
      "properties": {
        "arm_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        },
        "runtime_run_file_sha256": {"$ref": "#/$defs/sha256"},
        "producer_contract_sha256": {"$ref": "#/$defs/sha256"},
        "producer_contract": {"$ref": "#/$defs/producerContract"},
        "case_ids_sha256": {"$ref": "#/$defs/sha256"},
        "actual_cascades_sha256": {"$ref": "#/$defs/sha256"},
        "actual_cascades": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/cascade"}
        }
      }
    }
  }
}
