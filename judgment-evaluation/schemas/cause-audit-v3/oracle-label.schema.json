{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/cause-audit-v3/oracle-label.schema.json",
  "title": "Typed semantic Cause oracle label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "partition",
    "disposition",
    "meanings",
    "priority"
  ],
  "properties": {
    "schema_version": {"const": "chesstory.eval.cause-audit-oracle.v3"},
    "case_id": {"$ref": "#/$defs/id"},
    "partition": {"enum": ["explore", "sealed_confirm"]},
    "disposition": {"enum": ["answerable", "must_abstain", "unresolved"]},
    "meanings": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/meaning"}
    },
    "priority": {"$ref": "#/$defs/priority"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "uciMove": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    },
    "side": {"enum": ["white", "black"]},
    "sourceSide": {"enum": ["reference", "candidate", "shared", "mixed"]},
    "causeKind": {
      "enum": [
        "missed_tactical_resource",
        "tactical_refutation_of_played",
        "candidate_tactical_liability",
        "wrong_recapturer",
        "recapture_recovery_window",
        "wrong_move_order",
        "only_move_necessity",
        "only_defense_necessity",
        "tempo_loss",
        "conversion_miss",
        "conversion_secured",
        "sacrifice_compensation",
        "structural_improvement",
        "target_pressure_gain",
        "target_pressure_release",
        "center_control_gain",
        "king_safety_concession",
        "pawn_weakness_target",
        "pawn_break_opportunity",
        "activity_gain",
        "activity_loss",
        "opponent_restriction",
        "strategic_concession",
        "missed_strategic_improvement",
        "plan_improvement",
        "plan_contradiction",
        "defensive_resource",
        "draw_resource",
        "king_forcing",
        "material_swing"
      ]
    },
    "chessObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key"],
      "properties": {
        "kind": {
          "enum": [
            "move", "piece", "side", "square", "file", "pawn",
            "plan_subject", "relation", "motif", "line", "mechanism",
            "consequence", "horizon"
          ]
        },
        "key": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "objectSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowed"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/chessObject"}
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/chessObject"}
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["move", "side", "piece", "from", "to"],
      "properties": {
        "move": {"$ref": "#/$defs/uciMove"},
        "side": {"$ref": "#/$defs/side"},
        "piece": {"enum": ["pawn", "knight", "bishop", "rook", "queen", "king"]},
        "from": {"type": "string", "pattern": "^[a-h][1-8]$"},
        "to": {"type": "string", "pattern": "^[a-h][1-8]$"}
      }
    },
    "semanticLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "root_move"],
      "properties": {
        "role": {"enum": ["played", "best_reference", "alternative", "threat"]},
        "root_move": {"$ref": "#/$defs/uciMove"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mover",
        "reference_root_move",
        "candidate_root_move",
        "event_role",
        "event_root_move"
      ],
      "properties": {
        "kind": {
          "enum": [
            "played_vs_best",
            "played_vs_alternative",
            "best_vs_second",
            "reference_vs_alternative"
          ]
        },
        "mover": {"$ref": "#/$defs/side"},
        "reference_root_move": {"$ref": "#/$defs/uciMove"},
        "candidate_root_move": {"$ref": "#/$defs/uciMove"},
        "event_role": {"enum": ["played", "best_reference", "alternative", "threat"]},
        "event_root_move": {"$ref": "#/$defs/uciMove"}
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_change",
        "played_change",
        "actor",
        "targets",
        "mechanisms",
        "consequences",
        "line",
        "horizon"
      ],
      "properties": {
        "direct_change": {"$ref": "#/$defs/change"},
        "played_change": {"$ref": "#/$defs/change"},
        "actor": {"$ref": "#/$defs/actor"},
        "targets": {"$ref": "#/$defs/objectSet"},
        "mechanisms": {"$ref": "#/$defs/objectSet"},
        "consequences": {"$ref": "#/$defs/objectSet"},
        "line": {"$ref": "#/$defs/semanticLine"},
        "horizon": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 255}
          ]
        }
      }
    },
    "change": {
      "enum": ["occurred", "prevented", "maintained", "lost", "refuted", "missed"]
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause_kind",
        "comparison",
        "source_side",
        "attribution_kind",
        "effect_mode",
        "channels"
      ],
      "properties": {
        "cause_kind": {"$ref": "#/$defs/causeKind"},
        "comparison": {"$ref": "#/$defs/comparison"},
        "source_side": {"$ref": "#/$defs/sourceSide"},
        "attribution_kind": {
          "enum": [
            "reference_creates_resource",
            "candidate_allows_liability",
            "candidate_creates_value",
            "shared_context",
            "context_only",
            "unattributed"
          ]
        },
        "effect_mode": {
          "enum": ["played_liability", "alternative_resource", "played_value"]
        },
        "channels": {
          "description": "Conjunctive semantic channel set. Every expected channel must match one distinct actual channel and no extra actual semantic channel is allowed.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/channel"}
        }
      }
    },
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning_id",
        "generation_policy",
        "exposure_policy",
        "dominated_by",
        "realizations"
      ],
      "properties": {
        "meaning_id": {"$ref": "#/$defs/id"},
        "generation_policy": {"enum": ["required", "allowed", "forbidden"]},
        "exposure_policy": {
          "enum": [
            "primary",
            "complementary",
            "diagnostic_only",
            "fallback_only",
            "forbidden"
          ]
        },
        "dominated_by": {
          "type": "array",
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/id"}
        },
        "realizations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/realization"}
        }
      }
    },
    "precedence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["higher", "lower"],
      "properties": {
        "higher": {"$ref": "#/$defs/id"},
        "lower": {"$ref": "#/$defs/id"}
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tie_groups", "precedes", "required_top_one_of"],
      "properties": {
        "tie_groups": {
          "type": "array",
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "x-canonical": {"mode": "unordered-set"},
            "items": {"$ref": "#/$defs/id"}
          }
        },
        "precedes": {
          "type": "array",
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/precedence"}
        },
        "required_top_one_of": {
          "type": "array",
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/id"}
        }
      }
    }
  }
}
