{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/cause-audit-v3/open-world-candidate-set.schema.json",
  "title": "All-arm source-blind atomic Cause candidate set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partition",
    "arm_scope",
    "arm_inventory_sha256",
    "arm_inventory_semantic_sha256",
    "arm_ids_sha256",
    "base_oracle_file_sha256",
    "case_ids_sha256",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "chesstory.eval.cause-audit-open-world-candidates.v3"
    },
    "partition": {"enum": ["explore", "sealed_confirm"]},
    "arm_scope": {"const": "all_arms"},
    "arm_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "arm_inventory_semantic_sha256": {"$ref": "#/$defs/sha256"},
    "arm_ids_sha256": {"$ref": "#/$defs/sha256"},
    "base_oracle_file_sha256": {"$ref": "#/$defs/sha256"},
    "case_ids_sha256": {"$ref": "#/$defs/sha256"},
    "candidates": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateId": {
      "type": "string",
      "pattern": "^ow:[0-9a-f]{64}$"
    },
    "atomSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "oracle-label.schema.json#/$defs/chessObject"}
    },
    "candidateChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_change",
        "actor",
        "targets",
        "mechanisms",
        "consequences",
        "line",
        "horizon"
      ],
      "properties": {
        "direct_change": {"$ref": "oracle-label.schema.json#/$defs/change"},
        "actor": {"$ref": "#/$defs/atomSet"},
        "targets": {"$ref": "#/$defs/atomSet"},
        "mechanisms": {"$ref": "#/$defs/atomSet"},
        "consequences": {"$ref": "#/$defs/atomSet"},
        "line": {"$ref": "oracle-label.schema.json#/$defs/semanticLine"},
        "horizon": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 255}
          ]
        }
      }
    },
    "selectedChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_change",
        "played_change",
        "actor",
        "targets",
        "mechanisms",
        "consequences",
        "line",
        "horizon"
      ],
      "properties": {
        "direct_change": {"$ref": "oracle-label.schema.json#/$defs/change"},
        "played_change": {"$ref": "oracle-label.schema.json#/$defs/change"},
        "actor": {"$ref": "#/$defs/atomSet"},
        "targets": {"$ref": "#/$defs/atomSet"},
        "mechanisms": {"$ref": "#/$defs/atomSet"},
        "consequences": {"$ref": "#/$defs/atomSet"},
        "line": {"$ref": "oracle-label.schema.json#/$defs/semanticLine"},
        "horizon": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 255}
          ]
        }
      }
    },
    "cSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause_kind",
        "source_side",
        "attribution",
        "comparison",
        "channels"
      ],
      "properties": {
        "cause_kind": {"$ref": "oracle-label.schema.json#/$defs/causeKind"},
        "source_side": {"$ref": "oracle-label.schema.json#/$defs/sourceSide"},
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "root_move_matched", "direct_proof_eligible"],
          "properties": {
            "kind": {
              "enum": [
                "reference_creates_resource",
                "candidate_allows_liability",
                "candidate_creates_value",
                "shared_context",
                "context_only",
                "unattributed"
              ]
            },
            "root_move_matched": {"type": "boolean"},
            "direct_proof_eligible": {"type": "boolean"}
          }
        },
        "comparison": {
          "$ref": "oracle-label.schema.json#/$defs/comparison"
        },
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/candidateChannel"}
        }
      }
    },
    "selectionVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposure", "effect_mode", "channels"],
      "properties": {
        "exposure": {"enum": ["primary", "complementary"]},
        "effect_mode": {
          "enum": ["played_liability", "alternative_resource", "played_value"]
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/selectedChannel"}
        }
      }
    },
    "observationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_stages", "c_semantics", "selection_variants"],
      "properties": {
        "observed_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {
            "enum": [
              "c_generated",
              "jp_direct",
              "ja_admitted",
              "r_selected",
              "packet_selected",
              "public_selected"
            ]
          }
        },
        "c_semantics": {"$ref": "#/$defs/cSemantics"},
        "selection_variants": {
          "type": "array",
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"$ref": "#/$defs/selectionVariant"}
        }
      }
    },
    "candidatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c_semantics"],
      "properties": {
        "c_semantics": {"$ref": "#/$defs/cSemantics"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "case_id",
        "c_semantics_sha256",
        "payload_sha256",
        "payload"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/candidateId"},
        "case_id": {"$ref": "oracle-label.schema.json#/$defs/id"},
        "c_semantics_sha256": {"$ref": "#/$defs/sha256"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "payload": {"$ref": "#/$defs/candidatePayload"}
      }
    }
  }
}
