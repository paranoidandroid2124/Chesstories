{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-commentary-v6/position-commentary-engine-work-report.schema.json",
  "title": "Chesstory browser engine work report v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_profile", "work_id", "execution_key_sha256", "outcome"],
  "properties": {
    "schema_version": {"const": "chesstory.position-commentary.engine-work-report.v6"},
    "engine_profile": {"$ref": "#/$defs/engineProfile"},
    "work_id": {"type": "string", "pattern": "^work:[0-9]+$"},
    "execution_key_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outcome": {
      "oneOf": [
        {"$ref": "#/$defs/completed"},
        {"$ref": "#/$defs/executorFailed"}
      ]
    }
  },
  "$defs": {
    "engineProfile": {"const": "sf18-smallnet-t2-h16-v1"},
    "uciMove": {"type": "string", "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"},
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "line_suffixes"],
      "properties": {
        "kind": {"const": "completed"},
        "line_suffixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/lineSuffix"}
        }
      }
    },
    "executorFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "failure_code"],
      "properties": {
        "kind": {"const": "executor_failed"},
        "failure_code": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "lineSuffix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moves", "depth", "white_score"],
      "properties": {
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/uciMove"}
        },
        "depth": {"type": "integer", "minimum": 1, "maximum": 100},
        "white_score": {
          "oneOf": [
            {"$ref": "#/$defs/cpScore"},
            {"$ref": "#/$defs/mateScore"}
          ]
        }
      }
    },
    "cpScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "cp"},
        "value": {"type": "integer", "minimum": -100000, "maximum": 100000}
      }
    },
    "mateScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "mate"},
        "value": {
          "oneOf": [
            {"type": "integer", "minimum": -1000, "maximum": -1},
            {"type": "integer", "minimum": 1, "maximum": 1000}
          ]
        }
      }
    }
  }
}
