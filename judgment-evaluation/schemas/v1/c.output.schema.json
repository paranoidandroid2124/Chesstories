{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/v1/c.output.schema.json",
  "title": "C output v1",
  "$comment": "Structured actor/target/mechanism/consequence causes with direction and closed fact/evidence support.",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/stageDocument" },
    {
      "type": "object",
      "properties": {
        "stage": { "const": "C" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "payload": { "$ref": "common.schema.json#/$defs/causeBundle" }
  }
}
