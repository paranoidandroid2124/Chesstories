{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/v1/v.input.schema.json",
  "title": "V input v1",
  "$comment": "Verbalization sees only the preserved projection and a frozen grounding policy.",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/stageDocument" },
    {
      "type": "object",
      "properties": {
        "stage": { "const": "V" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["projection", "verbalization_policy"],
      "properties": {
        "projection": { "$ref": "common.schema.json#/$defs/projection" },
        "verbalization_policy": { "$ref": "common.schema.json#/$defs/verbalizationPolicy" }
      },
      "additionalProperties": false
    }
  }
}
