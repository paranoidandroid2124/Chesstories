{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/v1/ja.input.schema.json",
  "title": "Ja input v1",
  "$comment": "Judgment admission receives the proposed claims and the facts/causes needed to discharge their proof obligations.",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/stageDocument" },
    {
      "type": "object",
      "properties": {
        "stage": { "const": "Ja" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    }
  ],
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["fact_bundle", "cause_bundle", "proposal_bundle"],
      "properties": {
        "fact_bundle": { "$ref": "common.schema.json#/$defs/factBundle" },
        "cause_bundle": { "$ref": "common.schema.json#/$defs/causeBundle" },
        "proposal_bundle": { "$ref": "common.schema.json#/$defs/proposalBundle" }
      },
      "additionalProperties": false
    }
  }
}
