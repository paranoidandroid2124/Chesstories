{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-move-review-v5/move-review-snapshot.schema.json",
  "title": "Chesstory move review snapshot v5",
  "oneOf": [
    { "$ref": "#/$defs/awaitingCoreSnapshot" },
    { "$ref": "#/$defs/awaitingEvidenceSnapshot" },
    { "$ref": "#/$defs/completedSnapshot" }
  ],
  "$defs": {
    "awaitingCoreSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "job_id",
        "engine_profile",
        "state",
        "judgment_revision",
        "annotation_policy_revision",
        "subject",
        "progress",
        "issued_engine_work"
      ],
      "properties": {
        "schema_version": { "const": "chesstory.move-review.snapshot.v5" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "engine_profile": { "$ref": "#/$defs/engineProfile" },
        "state": { "const": "awaiting_core" },
        "judgment_revision": { "$ref": "#/$defs/revision" },
        "annotation_policy_revision": { "$ref": "#/$defs/revision" },
        "subject": { "$ref": "#/$defs/subject" },
        "progress": { "$ref": "#/$defs/coreProgress" },
        "issued_engine_work": { "$ref": "#/$defs/issuedEngineWork" }
      }
    },
    "awaitingEvidenceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "job_id",
        "engine_profile",
        "state",
        "judgment_revision",
        "annotation_policy_revision",
        "subject",
        "core",
        "progress",
        "issued_engine_work"
      ],
      "properties": {
        "schema_version": { "const": "chesstory.move-review.snapshot.v5" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "engine_profile": { "$ref": "#/$defs/engineProfile" },
        "state": { "const": "awaiting_evidence" },
        "judgment_revision": { "$ref": "#/$defs/revision" },
        "annotation_policy_revision": { "$ref": "#/$defs/revision" },
        "subject": { "$ref": "#/$defs/subject" },
        "core": { "$ref": "#/$defs/core" },
        "progress": { "$ref": "#/$defs/evidenceProgress" },
        "issued_engine_work": { "$ref": "#/$defs/issuedEngineWork" }
      }
    },
    "completedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "job_id",
        "engine_profile",
        "state",
        "judgment_revision",
        "annotation_policy_revision",
        "subject",
        "core",
        "evidence"
      ],
      "properties": {
        "schema_version": { "const": "chesstory.move-review.snapshot.v5" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "job_id": { "$ref": "#/$defs/jobId" },
        "engine_profile": { "$ref": "#/$defs/engineProfile" },
        "state": { "const": "completed" },
        "judgment_revision": { "$ref": "#/$defs/revision" },
        "annotation_policy_revision": { "$ref": "#/$defs/revision" },
        "subject": { "$ref": "#/$defs/subject" },
        "core": { "$ref": "#/$defs/core" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "engineProfile": {
      "enum": ["sf18-smallnet-t2-h16-v1", "sf18-smallnet-single-t1-h16-v1"]
    },
    "variant": { "enum": ["standard", "chess960"] },
    "fen": { "type": "string", "minLength": 1, "maxLength": 128 },
    "san": { "type": "string", "minLength": 1, "maxLength": 64 },
    "uciMove": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "initial_fen", "move_prefix_uci", "before_fen", "played_move_uci", "after_fen"],
      "properties": {
        "variant": { "$ref": "#/$defs/variant" },
        "initial_fen": { "$ref": "#/$defs/fen" },
        "move_prefix_uci": {
          "type": "array",
          "items": { "$ref": "#/$defs/uciMove" }
        },
        "before_fen": { "$ref": "#/$defs/fen" },
        "played_move_uci": { "$ref": "#/$defs/uciMove" },
        "after_fen": { "$ref": "#/$defs/fen" }
      }
    },
    "coreProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "root_lines_collected",
        "candidates_completed",
        "proofs_completed",
        "engine_work_issued",
        "engine_work_reports_accepted"
      ],
      "properties": {
        "phase": { "const": "core" },
        "root_lines_collected": { "type": "integer", "minimum": 0 },
        "candidates_completed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "proofs_completed": { "type": "integer", "minimum": 0 },
        "engine_work_issued": { "type": "integer", "minimum": 0 },
        "engine_work_reports_accepted": { "type": "integer", "minimum": 0 }
      }
    },
    "evidenceProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "root_lines_collected",
        "candidates_completed",
        "proofs_completed",
        "engine_work_issued",
        "engine_work_reports_accepted"
      ],
      "properties": {
        "phase": { "const": "evidence" },
        "root_lines_collected": { "type": "integer", "minimum": 0 },
        "candidates_completed": { "type": "integer", "minimum": 0, "maximum": 3 },
        "proofs_completed": { "type": "integer", "minimum": 0 },
        "engine_work_issued": { "type": "integer", "minimum": 0 },
        "engine_work_reports_accepted": { "type": "integer", "minimum": 0 }
      }
    },
    "issuedEngineWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "engine_profile",
        "variant",
        "engine_position_initial_fen",
        "engine_position_moves_uci",
        "search_fen",
        "required_depth",
        "multi_pv"
      ],
      "properties": {
        "work_id": { "type": "string", "pattern": "^work:[0-9]+$" },
        "engine_profile": { "$ref": "#/$defs/engineProfile" },
        "variant": { "$ref": "#/$defs/variant" },
        "engine_position_initial_fen": { "$ref": "#/$defs/fen" },
        "engine_position_moves_uci": {
          "type": "array",
          "items": { "$ref": "#/$defs/uciMove" }
        },
        "search_fen": { "$ref": "#/$defs/fen" },
        "required_depth": { "const": 16 },
        "multi_pv": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "properties": {
          "primary_reason_ref": { "type": "null" },
          "support_reason_refs": { "minItems": 1 }
        }
      },
      "required": [
        "verdict_ref",
        "verdict_symbol",
        "played_move_uci",
        "best_move_uci",
        "win_chance",
        "primary_reason_ref",
        "support_reason_refs",
        "background_reason_refs"
      ],
      "properties": {
        "verdict_ref": { "$ref": "#/$defs/identifier" },
        "verdict_symbol": { "enum": ["!!", "!", "!?", "none", "?!", "?", "??"] },
        "played_move_uci": { "$ref": "#/$defs/uciMove" },
        "best_move_uci": { "$ref": "#/$defs/uciMove" },
        "win_chance": { "$ref": "#/$defs/winChance" },
        "primary_reason_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }]
        },
        "support_reason_refs": {
          "allOf": [{ "$ref": "#/$defs/reasonRefArray" }, { "maxItems": 2 }]
        },
        "background_reason_refs": { "$ref": "#/$defs/reasonRefArray" }
      }
    },
    "winChance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_percent", "after_percent", "change_percentage_points"],
      "properties": {
        "before_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "after_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "change_percentage_points": { "type": "number", "minimum": -100, "maximum": 100 }
      }
    },
    "reasonRefArray": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "reasons", "proofs"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "reasons": {
          "type": "array",
          "maxItems": 9,
          "items": { "$ref": "#/$defs/reason" }
        },
        "proofs": {
          "type": "array",
          "maxItems": 9,
          "items": { "$ref": "#/$defs/proof" }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["move_uci", "move_san", "roles", "win_percent_for_mover"],
      "properties": {
        "move_uci": { "$ref": "#/$defs/uciMove" },
        "move_san": { "$ref": "#/$defs/san" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["best", "played", "alternative"] }
        },
        "win_percent_for_mover": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "message_key", "message_slots", "display_tags", "proof_id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "message_key": { "const": "move_review.reason.for_candidate" },
        "message_slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_move_uci"],
          "properties": {
            "candidate_move_uci": { "$ref": "#/$defs/uciMove" }
          }
        },
        "display_tags": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "book",
              "forced_reply",
              "only_move",
              "unique_defense",
              "drawing_resource",
              "underpromotion",
              "sound_sacrifice",
              "nontrivial_unique_defense",
              "nontrivial_drawing_resource",
              "quiet_forcing_move"
            ]
          }
        },
        "proof_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_fen", "steps", "annotations"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "start_fen": { "$ref": "#/$defs/fen" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/proofStep" }
        },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        }
      }
    },
    "proofStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["move_uci", "move_san", "fen_after"],
      "properties": {
        "move_uci": { "$ref": "#/$defs/uciMove" },
        "move_san": { "$ref": "#/$defs/san" },
        "fen_after": { "$ref": "#/$defs/fen" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_ply", "shape"],
      "properties": {
        "at_ply": { "type": "integer", "minimum": 1, "maximum": 12 },
        "shape": {
          "oneOf": [{ "$ref": "#/$defs/arrow" }, { "$ref": "#/$defs/square" }]
        }
      }
    },
    "brush": { "enum": ["green", "blue", "yellow", "red"] },
    "boardKey": { "type": "string", "pattern": "^[a-h][1-8]$" },
    "arrow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "orig", "dest", "brush"],
      "properties": {
        "kind": { "const": "arrow" },
        "orig": { "$ref": "#/$defs/boardKey" },
        "dest": { "$ref": "#/$defs/boardKey" },
        "brush": { "$ref": "#/$defs/brush" }
      }
    },
    "square": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "brush"],
      "properties": {
        "kind": { "const": "square" },
        "key": { "$ref": "#/$defs/boardKey" },
        "brush": { "$ref": "#/$defs/brush" }
      }
    }
  }
}
