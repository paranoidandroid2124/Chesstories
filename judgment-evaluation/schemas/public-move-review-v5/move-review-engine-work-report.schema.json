{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-move-review-v5/move-review-engine-work-report.schema.json",
  "title": "Chesstory move review engine work report v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_profile", "work_id", "outcome"],
  "properties": {
    "schema_version": {"const": "chesstory.move-review.engine-work-report.v5"},
    "engine_profile": {"$ref": "#/$defs/engineProfile"},
    "work_id": {"type": "string", "pattern": "^work:[0-9]+$"},
    "outcome": {
      "oneOf": [
        {"$ref": "#/$defs/executorFailed"},
        {"$ref": "#/$defs/completed"}
      ]
    }
  },
  "$defs": {
    "engineProfile": {
      "enum": ["sf18-smallnet-t2-h16-v1", "sf18-smallnet-single-t1-h16-v1"]
    },
    "uciMove": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    },
    "executorFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "executor_failed"}}
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "line_suffixes"],
      "properties": {
        "kind": {"const": "completed"},
        "line_suffixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/lineSuffix"}
        }
      }
    },
    "lineSuffix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moves", "depth", "white_score"],
      "properties": {
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/uciMove"}
        },
        "depth": {"type": "integer", "minimum": 16},
        "white_score": {
          "oneOf": [
            {"$ref": "#/$defs/cpScore"},
            {"$ref": "#/$defs/mateScore"}
          ]
        }
      }
    },
    "cpScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "cp"},
        "value": {"type": "integer"}
      }
    },
    "mateScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "mate"},
        "value": {
          "type": "integer",
          "not": {"const": 0}
        }
      }
    }
  }
}
