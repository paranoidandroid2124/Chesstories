{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/cause-audit-v1/case.schema.json",
  "title": "Blind source-only cause audit case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "inventory_id",
    "partition",
    "fen",
    "played_move_uci",
    "side_to_move",
    "game_phase",
    "cause_family",
    "source",
    "source_ordinal",
    "partition_rule",
    "reconstruction_confidence"
  ],
  "properties": {
    "schema_version": {"const": "cause-audit-curation-v1"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "inventory_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "partition": {"enum": ["explore", "sealed_confirm"]},
    "fen": {"type": "string", "minLength": 1, "maxLength": 127},
    "played_move_uci": {"$ref": "#/$defs/uciMove"},
    "side_to_move": {"enum": ["white", "black"]},
    "game_phase": {"enum": ["opening", "middlegame", "endgame"]},
    "cause_family": {
      "enum": [
        "activity_restriction",
        "conversion_control",
        "drawing_defense",
        "move_order_tempo",
        "pawn_breaks_center",
        "strategic_plan",
        "structure_targets",
        "tactical_resource"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "title",
        "game",
        "pdf_pages",
        "inventory_pages",
        "substitution"
      ],
      "properties": {
        "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "game": {"type": "string", "minLength": 1, "maxLength": 255},
        "pdf_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"type": "integer", "minimum": 1}
        },
        "inventory_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-canonical": {"mode": "unordered-set"},
          "items": {"type": "integer", "minimum": 1}
        },
        "substitution": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "selected_pdf_page", "reason"],
              "properties": {
                "kind": {"type": "string", "minLength": 1, "maxLength": 127},
                "selected_pdf_page": {"type": "integer", "minimum": 1},
                "reason": {"type": "string", "minLength": 1, "maxLength": 1023}
              }
            }
          ]
        }
      }
    },
    "source_ordinal": {"type": "integer", "minimum": 1},
    "partition_rule": {"const": "every_third_within_source_is_sealed_confirm"},
    "reconstruction_confidence": {"enum": ["high", "medium", "low"]}
  },
  "$defs": {
    "uciMove": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    }
  }
}
