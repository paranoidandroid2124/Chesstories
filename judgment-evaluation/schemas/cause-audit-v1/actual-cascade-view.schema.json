{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/cause-audit-v1/actual-cascade-view.schema.json",
  "title": "Compact actual C through P cause cascade view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "partition",
    "status",
    "initial_request_sha256",
    "final_request_sha256",
    "runtime_observation_sha256",
    "runtime",
    "public_response",
    "boundary",
    "projection",
    "probe_closure",
    "cause_count",
    "causes"
  ],
  "properties": {
    "schema_version": {"const": "chesstory.eval.cause-audit-actual-cascade.v1"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "partition": {"enum": ["explore", "sealed_confirm"]},
    "status": {"enum": ["complete", "unavailable", "adapter_error"]},
    "initial_request_sha256": {"$ref": "#/$defs/sha256"},
    "final_request_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_observation_sha256": {"$ref": "#/$defs/sha256"},
    "runtime": {"type": "object", "minProperties": 1},
    "public_response": {"type": "object", "minProperties": 1},
    "boundary": {"type": "object", "minProperties": 1},
    "projection": {"type": "object", "minProperties": 1},
    "probe_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_count",
        "issued_probe_count",
        "unique_probe_count",
        "all_closed",
        "stop_reason",
        "probe_request_sha256",
        "probe_result_sha256",
        "runtime_transport"
      ],
      "properties": {
        "round_count": {"type": "integer", "minimum": 1},
        "issued_probe_count": {"type": "integer", "minimum": 0},
        "unique_probe_count": {"type": "integer", "minimum": 0},
        "all_closed": {"type": "boolean"},
        "stop_reason": {
          "enum": [
            "all_runtime_probes_closed",
            "runtime_reissued_fulfilled_probes",
            "max_probe_rounds_reached",
            "adapter_not_complete"
          ]
        },
        "probe_request_sha256": {"$ref": "#/$defs/hashSet"},
        "probe_result_sha256": {"$ref": "#/$defs/hashSet"},
        "runtime_transport": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "round",
              "request_jsonl_sha256",
              "response_jsonl_sha256",
              "diagnostic_line_sha256",
              "diagnostic_stream_sha256"
            ],
            "properties": {
              "round": {"type": "integer", "minimum": 1},
              "request_jsonl_sha256": {"$ref": "#/$defs/sha256"},
              "response_jsonl_sha256": {"$ref": "#/$defs/sha256"},
              "diagnostic_line_sha256": {"$ref": "#/$defs/hashSet"},
              "diagnostic_stream_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "cause_count": {"type": "integer", "minimum": 0},
    "causes": {
      "type": "array",
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/causeCascade"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashSet": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {"$ref": "#/$defs/sha256"}
    },
    "sourceRef": {
      "type": "object",
      "required": ["id", "producer", "layer", "scope", "confidence", "record_registered"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "layer": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "minLength": 1},
        "record_registered": {"type": "boolean"},
        "record_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "causeCascade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cause_record", "c", "jp", "ja", "r", "p"],
      "properties": {
        "cause_record": {"$ref": "#/$defs/sourceRef"},
        "c": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source_side",
            "comparison_evidence",
            "support_evidence",
            "comparison",
            "attribution",
            "binding",
            "proof",
            "proof_state",
            "objects"
          ],
          "properties": {
            "kind": {"$ref": "#/$defs/causeKind"},
            "source_side": {"enum": ["reference", "candidate", "shared", "mixed"]},
            "comparison_evidence": {"$ref": "#/$defs/sourceRef"},
            "support_evidence": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}},
            "comparison": {"oneOf": [{"type": "null"}, {"type": "object", "minProperties": 1}]},
            "attribution": {"type": "object", "minProperties": 1},
            "binding": {"oneOf": [{"type": "null"}, {"type": "object", "minProperties": 1}]},
            "proof": {"type": "object", "minProperties": 1},
            "proof_state": {"type": "object", "minProperties": 1},
            "objects": {"type": "object", "minProperties": 1}
          }
        },
        "jp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linked_claims"],
          "properties": {"linked_claims": {"type": "array", "items": {"type": "object"}}}
        },
        "ja": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linked_decisions"],
          "properties": {"linked_decisions": {"type": "array", "items": {"type": "object"}}}
        },
        "r": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolutions", "ranked", "deduplication"],
          "properties": {
            "resolutions": {"type": "array", "items": {"type": "object"}},
            "ranked": {"type": "array", "items": {"type": "object"}},
            "deduplication": {"type": "array", "items": {"type": "object"}},
            "fallback_dominance": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "retained", "dominating_cause_evidence_ids"],
                  "properties": {
                    "status": {"enum": ["retained", "dominated_fallback"]},
                    "retained": {"type": "boolean"},
                    "dominating_cause_evidence_ids": {
                      "type": "array",
                      "items": {"type": "string"},
                      "uniqueItems": true
                    }
                  }
                }
              ]
            }
          }
        },
        "p": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packet_present", "packet_linked_claim_ids", "selected_public_idea_claim_ids"],
          "properties": {
            "packet_present": {"type": "boolean"},
            "packet_linked_claim_ids": {"type": "array", "items": {"type": "string"}},
            "selected_public_idea_claim_ids": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "causeKind": {
      "enum": [
        "missed_tactical_resource",
        "tactical_refutation_of_played",
        "candidate_tactical_liability",
        "wrong_recapturer",
        "recapture_recovery_window",
        "wrong_move_order",
        "only_move_necessity",
        "only_defense_necessity",
        "tempo_loss",
        "conversion_miss",
        "conversion_secured",
        "sacrifice_compensation",
        "structural_improvement",
        "target_pressure_gain",
        "target_pressure_release",
        "center_control_gain",
        "king_safety_concession",
        "pawn_weakness_target",
        "pawn_break_opportunity",
        "activity_gain",
        "activity_loss",
        "opponent_restriction",
        "strategic_concession",
        "missed_strategic_improvement",
        "plan_improvement",
        "plan_contradiction",
        "defensive_resource",
        "draw_resource",
        "king_forcing",
        "material_swing"
      ]
    }
  }
}
