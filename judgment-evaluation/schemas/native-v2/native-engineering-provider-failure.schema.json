{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/native-v2/native-engineering-provider-failure.schema.json",
  "title": "Chesstory diagnostic native provider failure capture v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "production_attribution_eligible",
    "inference_eligible",
    "production_bottleneck",
    "provider_binding",
    "invocation_sha256",
    "invocation_artifact",
    "failure"
  ],
  "properties": {
    "schema_version": {
      "const": "chesstory.eval.native-provider-failure.v1"
    },
    "status": { "const": "provider-timeout" },
    "production_attribution_eligible": { "const": false },
    "inference_eligible": { "const": false },
    "production_bottleneck": { "type": "null" },
    "provider_binding": {
      "allOf": [
        {
          "$ref": "native-engineering-report.schema.json#/$defs/providerBinding"
        },
        {
          "type": "object",
          "required": ["response_timeout_milliseconds"],
          "properties": {
            "schema_version": {
              "const": "chesstory.eval.native-command-provider-binding.v2"
            },
            "provider_kind": { "const": "persistent-jsonl-command" },
            "transport": { "const": "canonical-jsonl-utf8-stdio" },
            "response_timeout_milliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600000
            }
          }
        }
      ]
    },
    "invocation_sha256": { "$ref": "#/$defs/sha256" },
    "invocation_artifact": {
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "failure_kind",
        "deadline_policy",
        "configured_timeout_milliseconds",
        "diagnostic_line_count",
        "diagnostic_tail_sha256",
        "termination"
      ],
      "properties": {
        "failure_kind": { "const": "response-timeout" },
        "deadline_policy": { "const": "whole-invocation-monotonic" },
        "configured_timeout_milliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "diagnostic_line_count": { "type": "integer", "minimum": 0 },
        "diagnostic_tail_sha256": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "termination": {
          "type": "object",
          "required": [
            "attempted",
            "strategy",
            "parent_return_code",
            "reader_stopped"
          ],
          "properties": {
            "attempted": { "const": true },
            "strategy": {
              "enum": [
                "windows-process-tree-force",
                "posix-process-group-kill"
              ]
            },
            "parent_return_code": {
              "type": ["integer", "null"]
            },
            "reader_stopped": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
