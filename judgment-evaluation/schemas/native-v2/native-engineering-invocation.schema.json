{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/native-v2/native-engineering-invocation.schema.json",
  "title": "Chesstory diagnostic-only native intervention invocation v1",
  "type": "object",
  "required": ["schema_version", "binding", "runtime_request", "realization"],
  "properties": {
    "schema_version": { "const": "chesstory.runtime-native-engineering-invocation.v1" },
    "binding": { "$ref": "#/$defs/binding" },
    "runtime_request": {
      "type": "object",
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "const": "chesstory.move-meaning.request.v1" }
      }
    },
    "realization": { "$ref": "#/$defs/realization" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "binding": {
      "type": "object",
      "required": ["run_id", "sample_id", "atomic_cluster_id", "arm_id", "plan_sha256"],
      "properties": {
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "sample_id": { "$ref": "#/$defs/nonEmptyString" },
        "atomic_cluster_id": { "$ref": "#/$defs/nonEmptyString" },
        "arm_id": { "$ref": "#/$defs/nonEmptyString" },
        "plan_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "stringIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "selectExisting": {
      "type": "object",
      "required": ["operation"],
      "properties": {
        "operation": { "const": "select-existing" }
      }
    },
    "qDirective": {
      "allOf": [
        { "$ref": "#/$defs/selectExisting" },
        {
          "required": ["operation", "variation_ids", "probe_result_ids"],
          "properties": {
            "operation": { "const": "select-existing" },
            "variation_ids": { "$ref": "#/$defs/stringIds", "minItems": 1 },
            "probe_result_ids": { "$ref": "#/$defs/stringIds" }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidenceDirective": {
      "allOf": [
        { "$ref": "#/$defs/selectExisting" },
        {
          "required": ["operation", "evidence_record_ids"],
          "properties": {
            "operation": { "const": "select-existing" },
            "evidence_record_ids": { "$ref": "#/$defs/stringIds", "minItems": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "claimDirective": {
      "allOf": [
        { "$ref": "#/$defs/selectExisting" },
        {
          "required": ["operation", "claim_ids"],
          "properties": {
            "operation": { "const": "select-existing" },
            "claim_ids": { "$ref": "#/$defs/stringIds" }
          },
          "additionalProperties": false
        }
      ]
    },
    "rankingDirective": {
      "allOf": [
        { "$ref": "#/$defs/selectExisting" },
        {
          "required": ["operation", "ranked_claim_ids"],
          "properties": {
            "operation": { "const": "select-existing" },
            "ranked_claim_ids": { "$ref": "#/$defs/stringIds" }
          },
          "additionalProperties": false
        }
      ]
    },
    "projectionDirective": {
      "allOf": [
        { "$ref": "#/$defs/selectExisting" },
        {
          "required": ["operation", "probe_request_ids"],
          "properties": {
            "operation": { "const": "select-existing" },
            "probe_request_ids": { "$ref": "#/$defs/stringIds" }
          },
          "additionalProperties": false
        }
      ]
    },
    "directives": {
      "type": "object",
      "properties": {
        "Q": { "$ref": "#/$defs/qDirective" },
        "F": { "$ref": "#/$defs/evidenceDirective" },
        "C": { "$ref": "#/$defs/evidenceDirective" },
        "Jp": { "$ref": "#/$defs/claimDirective" },
        "R": { "$ref": "#/$defs/rankingDirective" },
        "P": { "$ref": "#/$defs/projectionDirective" }
      },
      "additionalProperties": false
    },
    "realization": {
      "type": "object",
      "required": ["kind", "directive_producer_tier", "frozen_source_semantics", "directives"],
      "properties": {
        "kind": { "type": "string", "enum": ["identity", "native-selection"] },
        "directive_producer_tier": {
          "type": "string",
          "enum": ["deterministic-engineering", "blind-model-proxy", "held-out-human-rater"]
        },
        "frozen_source_semantics": { "const": "not-claimed" },
        "directives": { "$ref": "#/$defs/directives" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "identity" } } },
          "then": { "properties": { "directives": { "maxProperties": 0 } } },
          "else": { "properties": { "directives": { "minProperties": 1 } } }
        }
      ],
      "additionalProperties": false
    }
  }
}
