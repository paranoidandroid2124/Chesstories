{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/native-v2/runtime-observation.schema.json",
  "title": "Chesstory runtime native boundary observation v2",
  "type": "object",
  "required": [
    "schema_version",
    "native_contract_version",
    "observation_status",
    "request_sha256",
    "runtime",
    "hash_contract",
    "artifact_chain_head_sha256",
    "stages"
  ],
  "properties": {
    "schema_version": { "const": "chesstory.runtime-observation.v2" },
    "native_contract_version": { "const": "chesstory.runtime-native-boundary.v2" },
    "observation_status": { "type": "string", "enum": ["complete", "adapter-error"] },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "public_response": { "$ref": "#/$defs/publicResponse" },
    "public_response_sha256": { "$ref": "#/$defs/sha256" },
    "hash_contract": { "const": "chesstory.sorted-object-keys-json-sha256.v1" },
    "artifact_chain_head_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "adapter_error": { "$ref": "#/$defs/adapterError" },
    "stages": { "$ref": "#/$defs/stages" }
  },
  "allOf": [
    {
      "if": { "properties": { "observation_status": { "const": "complete" } } },
      "then": {
        "required": ["public_response", "public_response_sha256"],
        "not": { "required": ["adapter_error"] }
      },
      "else": { "required": ["adapter_error"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stageId": {
      "type": "string",
      "enum": ["Q", "F", "C", "Jp", "Ja", "R", "P", "V"]
    },
    "runtime": {
      "type": "object",
      "required": [
        "adapter_name",
        "adapter_version",
        "request_schema",
        "response_schema",
        "boundary_execution_present",
        "projection_present"
      ],
      "properties": {
        "adapter_name": { "const": "chesstory-judgment-runtime-adapter" },
        "adapter_version": { "const": "0.2.0" },
        "request_schema": { "const": "chesstory.move-meaning.request.v1" },
        "response_schema": { "const": "chesstory.move-meaning.response.v2" },
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "boundary_execution_present": { "type": "boolean" },
        "projection_present": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "publicResponse": {
      "type": "object",
      "required": ["http_status", "body"],
      "properties": {
        "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "body": { "type": "object" }
      },
      "additionalProperties": false
    },
    "adapterError": {
      "type": "object",
      "required": ["kind", "class"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "native_snapshot_encoding_failed",
            "observation_assembly_failed",
            "runtime_evaluation_failed"
          ]
        },
        "class": { "type": "string", "minLength": 1 },
        "native_type": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "nativeArtifact": {
      "type": "object",
      "required": [
        "native_contract_version",
        "native_tree_contract_version",
        "stage",
        "capture_role",
        "upstream_artifact_sha256",
        "native_tree"
      ],
      "properties": {
        "native_contract_version": { "const": "chesstory.runtime-native-boundary.v2" },
        "native_tree_contract_version": { "const": "chesstory.runtime-native-tree.v2" },
        "stage": { "$ref": "#/$defs/stageId" },
        "capture_role": {
          "type": "string",
          "enum": ["observed-native-output", "observed-native-input-output", "typed-unavailability"]
        },
        "upstream_artifact_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "native_tree": {
          "$ref": "native-tree.schema.json"
        }
      },
      "additionalProperties": false
    },
    "stageRecord": {
      "type": "object",
      "required": [
        "stage_id",
        "status",
        "boundary_reached",
        "reason",
        "native_contract_version",
        "v1_semantic_mapping_status",
        "v1_semantic_mapping_reason",
        "upstream_artifact_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "stage_id": { "$ref": "#/$defs/stageId" },
        "status": { "type": "string", "enum": ["observed-native", "unavailable"] },
        "boundary_reached": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "native_contract_version": { "const": "chesstory.runtime-native-boundary.v2" },
        "v1_semantic_mapping_status": { "const": "unavailable" },
        "v1_semantic_mapping_reason": { "type": "string", "minLength": 1 },
        "upstream_artifact_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "artifact_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "artifact_role": {
          "type": "string",
          "enum": ["observed-native-output", "observed-native-input-output", "typed-unavailability"]
        },
        "artifact": { "$ref": "#/$defs/nativeArtifact" }
      },
      "allOf": [
        {
          "if": { "required": ["artifact"] },
          "then": {
            "required": ["artifact_role"],
            "properties": { "artifact_sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "observed-native" } } },
          "then": {
            "required": ["artifact", "artifact_role"],
            "properties": {
              "boundary_reached": { "const": true },
              "artifact_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "stages": {
      "type": "object",
      "required": ["Q", "F", "C", "Jp", "Ja", "R", "P", "V"],
      "properties": {
        "Q": { "$ref": "#/$defs/qStage" },
        "F": { "$ref": "#/$defs/fStage" },
        "C": { "$ref": "#/$defs/cStage" },
        "Jp": { "$ref": "#/$defs/jpStage" },
        "Ja": { "$ref": "#/$defs/jaStage" },
        "R": { "$ref": "#/$defs/rStage" },
        "P": { "$ref": "#/$defs/pStage" },
        "V": { "$ref": "#/$defs/vStage" }
      },
      "additionalProperties": false
    },
    "qStage": {
      "allOf": [
        { "$ref": "#/$defs/stageRecord" },
        {
          "properties": {
            "stage_id": { "const": "Q" },
            "artifact": { "properties": { "stage": { "const": "Q" } } }
          }
        }
      ]
    },
    "fStage": {
      "allOf": [
        { "$ref": "#/$defs/stageRecord" },
        {
          "properties": {
            "stage_id": { "const": "F" },
            "artifact": { "properties": { "stage": { "const": "F" } } }
          }
        }
      ]
    },
    "cStage": {
      "allOf": [
        { "$ref": "#/$defs/stageRecord" },
        {
          "properties": {
            "stage_id": { "const": "C" },
            "artifact": { "properties": { "stage": { "const": "C" } } }
          }
        }
      ]
    },
    "jpStage": {
      "allOf": [
        { "$ref": "#/$defs/stageRecord" },
        {
          "properties": {
            "stage_id": { "const": "Jp" },
            "artifact": { "properties": { "stage": { "const": "Jp" } } }
          }
        }
      ]
    },
    "jaStage": {
      "allOf": [
        { "$ref": "#/$defs/stageRecord" },
        {
          "properties": {
            "stage_id": { "const": "Ja" },
            "artifact": { "properties": { "stage": { "const": "Ja" } } }
          }
        }
      ]
    },
    "rStage": {
      "allOf": [
        { "$ref": "#/$defs/stageRecord" },
        {
          "properties": {
            "stage_id": { "const": "R" },
            "artifact": { "properties": { "stage": { "const": "R" } } }
          }
        }
      ]
    },
    "pStage": {
      "allOf": [
        { "$ref": "#/$defs/stageRecord" },
        {
          "properties": {
            "stage_id": { "const": "P" },
            "artifact": { "properties": { "stage": { "const": "P" } } }
          }
        }
      ]
    },
    "vStage": {
      "allOf": [
        { "$ref": "#/$defs/stageRecord" },
        {
          "properties": {
            "stage_id": { "const": "V" },
            "artifact": { "properties": { "stage": { "const": "V" } } }
          }
        }
      ]
    }
  }
}
