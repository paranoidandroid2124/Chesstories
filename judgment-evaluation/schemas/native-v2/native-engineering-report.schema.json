{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/native-v2/native-engineering-report.schema.json",
  "title": "Chesstory underpowered native engineering diagnostic report v2",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "binding",
    "created_at",
    "provider_binding",
    "plan",
    "sample_count",
    "atomic_cluster_count",
    "minimum_atomic_clusters",
    "actual_native_chain",
    "foundation_gate",
    "endpoint_evidence",
    "descriptive_candidates",
    "inference",
    "attribution",
    "production_bottleneck",
    "rows"
  ],
  "properties": {
    "schema_version": { "const": "chesstory.eval.native-engineering-report.v2" },
    "mode": { "const": "underpowered-engineering-diagnostic" },
    "binding": { "$ref": "#/$defs/binding" },
    "created_at": { "type": "string", "minLength": 1 },
    "provider_binding": { "$ref": "#/$defs/providerBinding" },
    "plan": { "$ref": "#/$defs/plan" },
    "sample_count": { "type": "integer", "minimum": 1 },
    "atomic_cluster_count": { "type": "integer", "minimum": 1 },
    "minimum_atomic_clusters": { "type": "integer", "minimum": 1 },
    "actual_native_chain": { "$ref": "#/$defs/actualNativeChain" },
    "foundation_gate": { "$ref": "#/$defs/foundationGate" },
    "endpoint_evidence": { "$ref": "#/$defs/endpointEvidence" },
    "descriptive_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/descriptiveCandidate" }
    },
    "inference": { "$ref": "#/$defs/inference" },
    "attribution": { "$ref": "#/$defs/attribution" },
    "production_bottleneck": { "type": "null" },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": {
      "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }]
    },
    "stage": {
      "type": "string",
      "enum": ["Q", "F", "C", "Jp", "Ja", "R", "P", "V"]
    },
    "sources": {
      "type": "object",
      "required": ["Q", "F", "C", "Jp", "Ja", "R", "P", "V"],
      "properties": {
        "Q": { "$ref": "#/$defs/source" },
        "F": { "$ref": "#/$defs/source" },
        "C": { "$ref": "#/$defs/source" },
        "Jp": { "$ref": "#/$defs/source" },
        "Ja": { "$ref": "#/$defs/source" },
        "R": { "$ref": "#/$defs/source" },
        "P": { "$ref": "#/$defs/source" },
        "V": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "enum": ["actual", "oracle", "format-control"]
    },
    "binding": {
      "type": "object",
      "required": [
        "run_id",
        "corpus_version",
        "split",
        "candidate_manifest_hash",
        "preregistration_sha256"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "corpus_version": { "$ref": "#/$defs/nonEmptyString" },
        "split": { "const": "diagnostic-explore" },
        "candidate_manifest_hash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "preregistration_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "arm": {
      "type": "object",
      "required": ["arm_id", "sources", "oracle_chain", "focus_stage", "context"],
      "properties": {
        "arm_id": { "$ref": "#/$defs/nonEmptyString" },
        "sources": { "$ref": "#/$defs/sources" },
        "oracle_chain": { "$ref": "#/$defs/nullableString" },
        "focus_stage": {
          "oneOf": [{ "$ref": "#/$defs/stage" }, { "type": "null" }]
        },
        "context": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "origin",
        "plan_sha256",
        "registered_arm_count",
        "planned_row_count",
        "materialized_row_count",
        "provider_invocation_count",
        "completed_row_count",
        "typed_unavailable_row_count",
        "invoked_arm_count",
        "completed_arm_count",
        "frozen_semantic_plan_complete",
        "arms"
      ],
      "properties": {
        "origin": { "const": "frozen-v1-arm-universe-native-v2-shadow" },
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "registered_arm_count": { "type": "integer", "minimum": 1 },
        "planned_row_count": { "type": "integer", "minimum": 1 },
        "materialized_row_count": { "type": "integer", "minimum": 1 },
        "provider_invocation_count": { "type": "integer", "minimum": 0 },
        "completed_row_count": { "type": "integer", "minimum": 0 },
        "typed_unavailable_row_count": { "type": "integer", "minimum": 0 },
        "invoked_arm_count": { "type": "integer", "minimum": 0 },
        "completed_arm_count": { "type": "integer", "minimum": 0 },
        "frozen_semantic_plan_complete": { "const": false },
        "arms": { "type": "array", "items": { "$ref": "#/$defs/arm" } }
      },
      "additionalProperties": false
    },
    "actualNativeChain": {
      "type": "object",
      "required": [
        "arm_id",
        "identity_realization_for_every_sample",
        "semantic_source_actual_native_for_every_sample",
        "Q_to_P_observed_for_every_sample",
        "V_status"
      ],
      "properties": {
        "arm_id": { "$ref": "#/$defs/nonEmptyString" },
        "identity_realization_for_every_sample": { "type": "boolean" },
        "semantic_source_actual_native_for_every_sample": { "type": "boolean" },
        "Q_to_P_observed_for_every_sample": { "type": "boolean" },
        "V_status": { "const": "typed-unavailable" }
      },
      "additionalProperties": false
    },
    "foundationGate": {
      "type": "object",
      "required": ["status", "formal_release_gate_evaluated", "reasons"],
      "properties": {
        "status": { "const": "closed" },
        "formal_release_gate_evaluated": { "const": false },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "endpointEvidence": {
      "type": "object",
      "required": ["held_out_human", "model_proxy"],
      "properties": {
        "held_out_human": {
          "type": "object",
          "required": ["status", "count", "eligible_for_release_gate"],
          "properties": {
            "status": { "const": "unavailable" },
            "count": { "const": 0 },
            "eligible_for_release_gate": { "const": false }
          },
          "additionalProperties": false
        },
        "model_proxy": {
          "type": "object",
          "required": [
            "evidence_tier",
            "aggregate_count",
            "human_gate_eligible",
            "release_eligible",
            "attribution_eligible"
          ],
          "properties": {
            "evidence_tier": { "const": "model-proxy-nonhuman" },
            "aggregate_count": { "type": "integer", "minimum": 0 },
            "human_gate_eligible": { "const": false },
            "release_eligible": { "const": false },
            "attribution_eligible": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "descriptiveCandidate": {
      "type": "object",
      "required": [
        "arm_id",
        "evidence_tier",
        "paired_sample_count",
        "paired_atomic_cluster_count",
        "raw_mean_delta_vs_actual",
        "confidence_interval",
        "p_value",
        "multiplicity_adjusted_p_value",
        "eligible_for_attribution"
      ],
      "properties": {
        "arm_id": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_tier": { "const": "model-proxy-nonhuman" },
        "paired_sample_count": { "type": "integer", "minimum": 1 },
        "paired_atomic_cluster_count": { "type": "integer", "minimum": 1 },
        "raw_mean_delta_vs_actual": { "type": "number" },
        "confidence_interval": { "type": "null" },
        "p_value": { "type": "null" },
        "multiplicity_adjusted_p_value": { "type": "null" },
        "eligible_for_attribution": { "const": false }
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "confidence_intervals",
        "p_values",
        "multiplicity_adjustment"
      ],
      "properties": {
        "status": { "const": "not-run" },
        "reason": { "const": "engineering-mode-is-hard-sealed-against-inference" },
        "confidence_intervals": { "type": "null" },
        "p_values": { "type": "null" },
        "multiplicity_adjustment": { "type": "null" }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "required": [
        "status",
        "production_bottleneck",
        "production_bottleneck_kind",
        "production_interface_bottleneck",
        "reason"
      ],
      "properties": {
        "status": { "const": "indeterminate" },
        "production_bottleneck": { "type": "null" },
        "production_bottleneck_kind": { "type": "null" },
        "production_interface_bottleneck": { "type": "null" },
        "reason": { "const": "native-engineering-results-are-descriptive-only" }
      },
      "additionalProperties": false
    },
    "artifactReference": {
      "type": "object",
      "required": ["sha256"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "path": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "descriptiveEndpoint": {
      "type": "object",
      "required": [
        "evidence_tier",
        "status",
        "engineering_proxy_E",
        "human_gate_eligible",
        "release_eligible",
        "attribution_eligible",
        "aggregate_sha256"
      ],
      "properties": {
        "evidence_tier": { "const": "model-proxy-nonhuman" },
        "status": { "type": "string", "enum": ["complete", "indeterminate"] },
        "engineering_proxy_E": {
          "oneOf": [{ "type": "integer", "enum": [0, 1] }, { "type": "null" }]
        },
        "human_gate_eligible": { "const": false },
        "release_eligible": { "const": false },
        "attribution_eligible": { "const": false },
        "aggregate_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "sample_id",
        "atomic_cluster_id",
        "arm_id",
        "registered_sources",
        "oracle_chain",
        "focus_stage",
        "context",
        "status",
        "realization_kind",
        "semantic_source_realization",
        "reason",
        "native_chain",
        "descriptive_endpoint",
        "production_attribution_eligible"
      ],
      "properties": {
        "sample_id": { "$ref": "#/$defs/nonEmptyString" },
        "atomic_cluster_id": { "$ref": "#/$defs/nonEmptyString" },
        "arm_id": { "$ref": "#/$defs/nonEmptyString" },
        "registered_sources": { "$ref": "#/$defs/sources" },
        "oracle_chain": { "$ref": "#/$defs/nullableString" },
        "focus_stage": {
          "oneOf": [{ "$ref": "#/$defs/stage" }, { "type": "null" }]
        },
        "context": { "$ref": "#/$defs/nonEmptyString" },
        "status": {
          "type": "string",
          "enum": ["q-p-observed", "native-chain-partial", "typed-unavailable", "adapter-error"]
        },
        "realization_kind": {
          "type": "string",
          "enum": ["identity", "native-selection", "unavailable"]
        },
        "directive_producer_tier": {
          "type": "string",
          "enum": ["deterministic-engineering", "blind-model-proxy", "held-out-human-rater"]
        },
        "semantic_source_realization": {
          "type": "string",
          "enum": ["actual-native", "unavailable"]
        },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "native_chain": {
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        },
        "invocation_artifact": { "$ref": "#/$defs/artifactReference" },
        "provider_io_artifact": { "$ref": "#/$defs/artifactReference" },
        "result_artifact": { "$ref": "#/$defs/artifactReference" },
        "descriptive_endpoint": {
          "oneOf": [{ "$ref": "#/$defs/descriptiveEndpoint" }, { "type": "null" }]
        },
        "production_attribution_eligible": { "const": false }
      },
      "allOf": [
        {
          "if": {
            "properties": { "realization_kind": { "const": "unavailable" } },
            "required": ["realization_kind"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["directive_producer_tier"] },
                { "required": ["invocation_artifact"] },
                { "required": ["provider_io_artifact"] },
                { "required": ["result_artifact"] }
              ]
            }
          },
          "else": {
            "required": [
              "directive_producer_tier",
              "invocation_artifact",
              "provider_io_artifact",
              "result_artifact"
            ]
          }
        },
        {
          "if": {
            "properties": { "realization_kind": { "const": "identity" } },
            "required": ["realization_kind"]
          },
          "then": {
            "properties": {
              "semantic_source_realization": { "const": "actual-native" }
            }
          }
        },
        {
          "if": {
            "properties": { "realization_kind": { "const": "native-selection" } },
            "required": ["realization_kind"]
          },
          "then": {
            "properties": {
              "semantic_source_realization": { "const": "unavailable" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "providerBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "schema_version",
            "provider_kind",
            "transport",
            "provider_identity_sha256",
            "command_argv_sha256",
            "executable_sha256",
            "working_directory_sha256",
            "binding_sha256"
          ],
          "properties": {
            "schema_version": { "const": "chesstory.eval.native-provider-binding.v1" },
            "provider_kind": {
              "enum": ["persistent-jsonl-command", "in-process-callable"]
            },
            "transport": {
              "enum": ["canonical-jsonl-utf8-stdio", "python-mapping-call"]
            },
            "provider_identity_sha256": { "$ref": "#/$defs/sha256" },
            "command_argv_sha256": {
              "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
            },
            "executable_sha256": {
              "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
            },
            "working_directory_sha256": {
              "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
            },
            "binding_sha256": { "$ref": "#/$defs/sha256" }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "provider_kind": { "const": "persistent-jsonl-command" }
                },
                "required": ["provider_kind"]
              },
              "then": {
                "properties": {
                  "transport": { "const": "canonical-jsonl-utf8-stdio" },
                  "command_argv_sha256": { "$ref": "#/$defs/sha256" },
                  "working_directory_sha256": { "$ref": "#/$defs/sha256" }
                }
              },
              "else": {
                "properties": {
                  "transport": { "const": "python-mapping-call" },
                  "command_argv_sha256": { "type": "null" },
                  "executable_sha256": { "type": "null" },
                  "working_directory_sha256": { "type": "null" }
                }
              }
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "provider_kind",
            "transport",
            "provider_identity_sha256",
            "command_argv_sha256",
            "executable_sha256",
            "working_directory_sha256",
            "response_timeout_milliseconds",
            "binding_sha256"
          ],
          "properties": {
            "schema_version": { "const": "chesstory.eval.native-command-provider-binding.v2" },
            "provider_kind": { "const": "persistent-jsonl-command" },
            "transport": { "const": "canonical-jsonl-utf8-stdio" },
            "provider_identity_sha256": { "$ref": "#/$defs/sha256" },
            "command_argv_sha256": { "$ref": "#/$defs/sha256" },
            "executable_sha256": {
              "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
            },
            "working_directory_sha256": { "$ref": "#/$defs/sha256" },
            "response_timeout_milliseconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600000
            },
            "binding_sha256": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
