{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-v6/move-meaning-response.schema.json",
  "title": "Chesstory public move-meaning response v6",
  "description": "Development-only direct wire contract emitted by RuntimeProtocol for response.v6.",
  "oneOf": [
    {"$ref": "#/$defs/errorResponse"},
    {"$ref": "#/$defs/readyResponse"}
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uciMove": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    },
    "side": {
      "enum": ["white", "black"]
    },
    "square": {
      "type": "string",
      "pattern": "^[a-h][1-8]$"
    },
    "pieceRole": {
      "enum": ["pawn", "knight", "bishop", "rook", "queen", "king"]
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "error"],
      "properties": {
        "schema_version": {"const": "chesstory.move-meaning.response.v6"},
        "request_id": {"$ref": "#/$defs/requestId"},
        "status": {"const": "error"},
        "error": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "readyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "move_commentary"],
      "properties": {
        "schema_version": {"const": "chesstory.move-meaning.response.v6"},
        "request_id": {"$ref": "#/$defs/requestId"},
        "status": {"const": "ready"},
        "move_commentary": {"$ref": "#/$defs/moveCommentary"}
      }
    },
    "moveCommentary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": {"$ref": "#/$defs/primary"},
        "occurrence_relations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/occurrenceRelation"}
        }
      }
    },
    "primary": {
      "oneOf": [
        {"$ref": "#/$defs/moveVerdictPrimary"},
        {"$ref": "#/$defs/bestChoicePrimary"}
      ]
    },
    "verdictCode": {
      "enum": [
        "improves_on_reference",
        "matches_reference",
        "playable_loss",
        "inaccuracy",
        "mistake",
        "blunder"
      ]
    },
    "verdictConfidence": {
      "enum": ["engine_backed", "legal_replay_verified", "mixed_verified"]
    },
    "comparisonDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidate_win_percent_delta_for_mover"],
      "properties": {
        "kind": {"enum": ["engine_evaluation", "outcome_only"]},
        "candidate_win_percent_delta_for_mover": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "moveVerdictPrimary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "comparison_evidence_id",
        "verdict_code",
        "verdict_confidence",
        "mover",
        "delta",
        "reference_endpoint",
        "played_endpoint"
      ],
      "properties": {
        "kind": {"const": "move_verdict"},
        "comparison_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "verdict_code": {"$ref": "#/$defs/verdictCode"},
        "verdict_confidence": {"$ref": "#/$defs/verdictConfidence"},
        "mover": {"enum": ["white", "black"]},
        "delta": {"$ref": "#/$defs/comparisonDelta"},
        "reference_endpoint": {"$ref": "#/$defs/endpoint"},
        "played_endpoint": {"$ref": "#/$defs/endpoint"}
      },
      "oneOf": [
        {
          "properties": {
            "verdict_confidence": {"const": "engine_backed"},
            "delta": {"properties": {"kind": {"const": "engine_evaluation"}}},
            "reference_endpoint": {"$ref": "#/$defs/engineEndpoint"},
            "played_endpoint": {"$ref": "#/$defs/engineEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "legal_replay_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "reference_endpoint": {"$ref": "#/$defs/terminalEndpoint"},
            "played_endpoint": {"$ref": "#/$defs/terminalEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "mixed_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "reference_endpoint": {"$ref": "#/$defs/engineEndpoint"},
            "played_endpoint": {"$ref": "#/$defs/terminalEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "mixed_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "reference_endpoint": {"$ref": "#/$defs/terminalEndpoint"},
            "played_endpoint": {"$ref": "#/$defs/engineEndpoint"}
          }
        }
      ]
    },
    "bestChoicePrimary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "comparison_evidence_id",
        "runner_up_verdict_code",
        "verdict_confidence",
        "mover",
        "delta",
        "best_endpoint",
        "runner_up_endpoint"
      ],
      "properties": {
        "kind": {"const": "best_choice"},
        "comparison_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "runner_up_verdict_code": {
          "enum": ["matches_reference", "playable_loss", "inaccuracy", "mistake", "blunder"]
        },
        "verdict_confidence": {"$ref": "#/$defs/verdictConfidence"},
        "mover": {"enum": ["white", "black"]},
        "delta": {"$ref": "#/$defs/comparisonDelta"},
        "best_endpoint": {"$ref": "#/$defs/endpoint"},
        "runner_up_endpoint": {"$ref": "#/$defs/endpoint"}
      },
      "oneOf": [
        {
          "properties": {
            "verdict_confidence": {"const": "engine_backed"},
            "delta": {"properties": {"kind": {"const": "engine_evaluation"}}},
            "best_endpoint": {"$ref": "#/$defs/engineEndpoint"},
            "runner_up_endpoint": {"$ref": "#/$defs/engineEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "legal_replay_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "best_endpoint": {"$ref": "#/$defs/terminalEndpoint"},
            "runner_up_endpoint": {"$ref": "#/$defs/terminalEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "mixed_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "best_endpoint": {"$ref": "#/$defs/engineEndpoint"},
            "runner_up_endpoint": {"$ref": "#/$defs/terminalEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "mixed_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "best_endpoint": {"$ref": "#/$defs/terminalEndpoint"},
            "runner_up_endpoint": {"$ref": "#/$defs/engineEndpoint"}
          }
        }
      ]
    },
    "endpoint": {
      "oneOf": [
        {"$ref": "#/$defs/engineEndpoint"},
        {"$ref": "#/$defs/terminalEndpoint"}
      ]
    },
    "engineEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "moves", "win_percent_for_mover", "depth"],
      "properties": {
        "kind": {"const": "engine_search"},
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/uciMove"}
        },
        "win_percent_for_mover": {"type": "number", "minimum": 0, "maximum": 100},
        "depth": {"type": "integer", "minimum": 0, "maximum": 100},
        "mate_forecast_white_pov": {"$ref": "#/$defs/nonZeroInteger"}
      },
      "oneOf": [
        {
          "required": ["mate_forecast_white_pov"]
        },
        {
          "not": {"required": ["mate_forecast_white_pov"]},
          "properties": {
            "depth": {"type": "integer", "minimum": 8, "maximum": 100}
          }
        }
      ]
    },
    "terminalEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "moves", "terminal"],
      "properties": {
        "kind": {"const": "exact_automatic_terminal"},
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/uciMove"}
        },
        "terminal": {"$ref": "#/$defs/automaticTerminal"}
      }
    },
    "nonZeroInteger": {
      "oneOf": [
        {"type": "integer", "minimum": -1000, "maximum": -1},
        {"type": "integer", "minimum": 1, "maximum": 1000}
      ]
    },
    "automaticTerminal": {
      "oneOf": [
        {"$ref": "#/$defs/checkmateTerminal"},
        {"$ref": "#/$defs/stalemateTerminal"},
        {"$ref": "#/$defs/insufficientMaterialTerminal"},
        {"$ref": "#/$defs/fivefoldRepetitionTerminal"},
        {"$ref": "#/$defs/seventyFiveMoveRuleTerminal"}
      ]
    },
    "checkmateTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "winner"],
      "properties": {
        "kind": {"const": "checkmate"},
        "winner": {"enum": ["white", "black"]}
      }
    },
    "stalemateTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "stalemate"}
      }
    },
    "insufficientMaterialTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "insufficient_material"}
      }
    },
    "fivefoldRepetitionTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "fivefold_repetition"}
      }
    },
    "seventyFiveMoveRuleTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "seventy_five_move_rule"}
      }
    },
    "occurrenceRelation": {
      "$ref": "#/$defs/relocationEnablesRecaptureOccurrenceRelation"
    },
    "relocationEnablesRecaptureOccurrenceRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_occurrence",
        "relation_kind",
        "proof"
      ],
      "properties": {
        "subject_occurrence": {"$ref": "#/$defs/relationSubjectOccurrence"},
        "relation_kind": {"const": "relocation_enables_recapture"},
        "proof": {
          "$ref": "#/$defs/occurrenceRelocationEnablesRecaptureProof"
        }
      }
    },
    "relationSubjectOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_id",
        "line_owner_evidence_id",
        "transition_evidence_id",
        "move_uci",
        "root_provenance",
        "line_id",
        "start",
        "destination"
      ],
      "properties": {
        "occurrence_id": {"$ref": "#/$defs/nonEmptyString"},
        "line_owner_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "transition_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "move_uci": {"$ref": "#/$defs/uciMove"},
        "root_provenance": {"const": "observed_game_root"},
        "line_id": {"$ref": "#/$defs/nonEmptyString"},
        "start": {"$ref": "#/$defs/relationSubjectPosition"},
        "destination": {"$ref": "#/$defs/relationSubjectPosition"}
      }
    },
    "relationSubjectPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fen", "ply"],
      "properties": {
        "fen": {"$ref": "#/$defs/nonEmptyString"},
        "ply": {"type": "integer", "minimum": 0}
      }
    },
    "occurrenceRelocationEnablesRecaptureProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_evidence_id",
        "semantic_id",
        "occurrence_id",
        "dependency_fingerprint",
        "relocated_responder_branch",
        "retained_responder_branch",
        "proof_paths",
        "participants",
        "relocation",
        "target_capture",
        "relocated_responder_recapture",
        "retained_other_recapture"
      ],
      "properties": {
        "source_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "occurrence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dependency_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "relocated_responder_branch": {
          "allOf": [
            {"$ref": "#/$defs/occurrenceRelationBranch"},
            {
              "properties": {
                "branch_role": {"const": "relocated_responder"}
              }
            }
          ]
        },
        "retained_responder_branch": {
          "allOf": [
            {"$ref": "#/$defs/occurrenceRelationBranch"},
            {
              "properties": {
                "branch_role": {"const": "retained_responder"}
              }
            }
          ]
        },
        "proof_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/occurrenceRelocationEnablesRecaptureProofPath"}
        },
        "participants": {"$ref": "#/$defs/occurrenceRelocationEnablesRecaptureParticipants"},
        "relocation": {"$ref": "#/$defs/occurrenceRelocationEnablesRecaptureIndexedMovement"},
        "target_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movement", "move_uci", "relocated_step_index", "retained_step_index"],
          "properties": {
            "movement": {"$ref": "#/$defs/boundedCausalMovement"},
            "move_uci": {"$ref": "#/$defs/uciMove"},
            "relocated_step_index": {"type": "integer", "minimum": 0},
            "retained_step_index": {"type": "integer", "minimum": 0}
          }
        },
        "relocated_responder_recapture": {"$ref": "#/$defs/occurrenceRelocationEnablesRecaptureIndexedMovement"},
        "retained_other_recapture": {"$ref": "#/$defs/occurrenceRelocationEnablesRecaptureIndexedMovement"}
      }
    },
    "occurrenceRelocationEnablesRecaptureProofPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_occurrence_id", "premises", "closed_absence_uses", "closed_state_uses"],
      "properties": {
        "path_occurrence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "premises": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/occurrenceRelocationEnablesRecaptureRelationPremiseUse"},
              {"$ref": "#/$defs/occurrenceRelocationEnablesRecaptureLegalMovePremiseUse"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role", "contract", "transition_kind", "overall_move_uci", "before", "after",
                  "legal_move_semantic_id", "transition_footprint_id", "issuer_evidence_id",
                  "issuer_occurrence_id", "source_premise_ids", "branch_id", "branch_role", "step_index"
                ],
                "properties": {
                  "role": {"enum": [
                    "relocated_branch_target_continuity",
                    "retained_branch_target_continuity",
                    "relocated_responder_continuity",
                    "retained_responder_continuity",
                    "relocated_branch_attacker_continuity",
                    "retained_branch_attacker_continuity"
                  ]},
                  "contract": {"const": "object_continuity_step"},
                  "transition_kind": {"enum": ["retained", "primary", "secondary"]},
                  "overall_move_uci": {"$ref": "#/$defs/uciMove"},
                  "before": {"$ref": "#/$defs/boundedCausalPiece"},
                  "after": {"$ref": "#/$defs/boundedCausalPiece"},
                  "selected_transition": {"$ref": "#/$defs/boundedCausalMovement"},
                  "legal_move_semantic_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "transition_footprint_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "issuer_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
                  "issuer_occurrence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "source_premise_ids": {
                    "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
                    "items": {"$ref": "#/$defs/nonEmptyString"}
                  },
                  "branch_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "branch_role": {"enum": ["relocated_responder", "retained_responder"]},
                  "step_index": {"type": "integer", "minimum": 0}
                },
                "oneOf": [
                  {
                    "properties": {"transition_kind": {"const": "retained"}},
                    "not": {"required": ["selected_transition"]}
                  },
                  {
                    "required": ["selected_transition"],
                    "properties": {"transition_kind": {"enum": ["primary", "secondary"]}}
                  }
                ]
              }
            ]
          },
          "allOf": [
            {"contains": {"properties": {"role": {"const": "relocated_recapture_inventory"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"role": {"const": "retained_recapture_inventory"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"role": {"const": "relocated_target_capture"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"role": {"const": "relocated_responder_recapture"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"role": {"const": "retained_target_capture"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"role": {"const": "retained_other_recapture"}}}, "minContains": 1, "maxContains": 1},
            {
              "contains": {
                "properties": {
                  "role": {"const": "relocated_branch_target_continuity"},
                  "contract": {"const": "object_continuity_step"}
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "role": {"const": "relocated_branch_attacker_continuity"},
                  "contract": {"const": "object_continuity_step"}
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "role": {"const": "relocated_responder_continuity"},
                  "contract": {"const": "object_continuity_step"}
                }
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "role": {"const": "retained_responder_continuity"},
                  "contract": {"const": "object_continuity_step"}
                }
              },
              "minContains": 1
            }
          ]
        },
        "closed_absence_uses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/occurrenceRelationClosureUse"},
              {"properties": {
                "role": {"const": "retained_seed_recapture_absent"},
                "issuer": {"const": "position_relation_extractor.closed_relation_inventory"},
                "query": {"type": "string", "pattern": "^legal-move-from-to:(white|black):[a-h][1-8]:[a-h][1-8]$"},
                "branch_role": {"const": "retained_responder"}
              }}
            ]
          }
        },
        "closed_state_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/occurrenceRelationClosureUse"},
              {"properties": {
                "role": {"enum": [
                  "relocated_branch_target_continuity",
                  "retained_branch_target_continuity",
                  "relocated_responder_continuity",
                  "retained_responder_continuity",
                  "relocated_branch_attacker_continuity",
                  "retained_branch_attacker_continuity"
                ]},
                "issuer": {"const": "position_relation_extractor.closed_position_state_inventory"},
                "query": {"type": "string", "pattern": "^occupied-by:(white|black):(pawn|knight|bishop|rook|queen|king)@[a-h][1-8]$"},
                "branch_role": {"enum": ["relocated_responder", "retained_responder"]}
              }}
            ]
          }
        }
      }
    },
    "occurrenceRelocationEnablesRecaptureRelationPremiseUse": {
      "allOf": [
        {"$ref": "#/$defs/occurrenceRelationPremiseUse"},
        {"properties": {
          "role": {"enum": ["relocated_recapture_inventory", "retained_recapture_inventory"]},
          "contract": {"const": "capture_recapture_inventory"},
          "result_id": {"pattern": "^capture_recapture_inventory:[0-9a-f]{64}$"}
        }},
        {"oneOf": [
          {"properties": {
            "role": {"const": "relocated_recapture_inventory"},
            "branch_role": {"const": "relocated_responder"}
          }},
          {"properties": {
            "role": {"const": "retained_recapture_inventory"},
            "branch_role": {"const": "retained_responder"}
          }}
        ]}
      ]
    },
    "occurrenceRelocationEnablesRecaptureLegalMovePremiseUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "contract", "move_uci", "movement", "movement_mode", "legal_move_semantic_id",
        "issuer_evidence_id", "issuer_occurrence_id", "source_premise_ids", "branch_id", "branch_role", "step_index", "capture"
      ],
      "properties": {
        "role": {"enum": [
          "relocated_target_capture",
          "relocated_responder_recapture",
          "retained_target_capture",
          "retained_other_recapture"
        ]},
        "contract": {"const": "legal_move"},
        "move_uci": {"$ref": "#/$defs/uciMove"},
        "movement": {"$ref": "#/$defs/boundedCausalMovement"},
        "movement_mode": {"enum": ["controlled_destination", "pawn_advance", "pawn_double_advance", "castling"]},
        "legal_move_semantic_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "issuer_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "issuer_occurrence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_premise_ids": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "branch_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "branch_role": {"enum": ["relocated_responder", "retained_responder"]},
        "step_index": {"type": "integer", "minimum": 0},
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["square", "piece", "side"],
          "properties": {
            "square": {"$ref": "#/$defs/square"},
            "piece": {"$ref": "#/$defs/pieceRole"},
            "side": {"$ref": "#/$defs/side"}
          }
        }
      }
    },
    "occurrenceRelocationEnablesRecaptureParticipants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attacker_at_common_root",
        "attacker_at_capture",
        "target_at_common_root",
        "captured_target",
        "recapture_square",
        "tracked_responder_at_seed",
        "tracked_responder_at_staging",
        "other_recapturer"
      ],
      "properties": {
        "attacker_at_common_root": {"$ref": "#/$defs/boundedCausalPiece"},
        "attacker_at_capture": {"$ref": "#/$defs/boundedCausalPiece"},
        "target_at_common_root": {"$ref": "#/$defs/boundedCausalPiece"},
        "captured_target": {"$ref": "#/$defs/boundedCausalPiece"},
        "recapture_square": {"$ref": "#/$defs/square"},
        "tracked_responder_at_seed": {"$ref": "#/$defs/boundedCausalPiece"},
        "tracked_responder_at_staging": {"$ref": "#/$defs/boundedCausalPiece"},
        "other_recapturer": {"$ref": "#/$defs/boundedCausalPiece"}
      }
    },
    "occurrenceRelocationEnablesRecaptureIndexedMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["movement", "move_uci", "step_index"],
      "properties": {
        "movement": {"$ref": "#/$defs/boundedCausalMovement"},
        "move_uci": {"$ref": "#/$defs/uciMove"},
        "step_index": {"type": "integer", "minimum": 0}
      }
    },
    "occurrenceRelationBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "line_id",
        "line_owner_evidence_id",
        "root_transition_evidence_id",
        "branch_role",
        "root_provenance",
        "root_move",
        "steps"
      ],
      "properties": {
        "branch_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "line_id": {"$ref": "#/$defs/nonEmptyString"},
        "line_owner_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "root_transition_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "branch_role": {"$ref": "#/$defs/nonEmptyString"},
        "root_provenance": {"enum": ["counterfactual_analyzed_root", "observed_game_root"]},
        "root_move": {"$ref": "#/$defs/uciMove"},
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/boundedCausalStep"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "root_provenance": {"const": "observed_game_root"},
            "steps": {
              "prefixItems": [
                {"properties": {"provenance": {"const": "observed_game_move"}}}
              ],
              "items": {"properties": {"provenance": {"const": "certified_analysis_move"}}}
            }
          }
        },
        {
          "properties": {
            "root_provenance": {"const": "counterfactual_analyzed_root"},
            "steps": {
              "items": {"properties": {"provenance": {"const": "certified_analysis_move"}}}
            }
          }
        }
      ]
    },
    "occurrenceRelationPremiseUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "contract", "result_id", "issuer_evidence_id", "issuer_occurrence_id",
        "source_premise_ids", "branch_id", "branch_role", "step_index"
      ],
      "properties": {
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "contract": {"enum": ["created_check_response_inventory", "capture_recapture_inventory", "slider_reach_delta"]},
        "result_id": {"type": "string", "pattern": "^(created_check_response_inventory|capture_recapture_inventory|slider_reach_delta):[0-9a-f]{64}$"},
        "issuer_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "issuer_occurrence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_premise_ids": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "branch_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "branch_role": {"$ref": "#/$defs/nonEmptyString"},
        "step_index": {"type": "integer", "minimum": 0}
      }
    },
    "occurrenceRelationClosureUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_id", "role", "semantic_proof_id", "issuer", "issuer_evidence_id",
        "issuer_occurrence_id", "query", "branch_id", "branch_role", "after_step_index", "position"
      ],
      "properties": {
        "use_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "semantic_proof_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "issuer": {"enum": ["position_relation_extractor.closed_relation_inventory", "position_relation_extractor.closed_position_state_inventory"]},
        "issuer_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "issuer_occurrence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "query": {"$ref": "#/$defs/nonEmptyString"},
        "branch_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "branch_role": {"$ref": "#/$defs/nonEmptyString"},
        "after_step_index": {"type": "integer", "minimum": 0},
        "position": {"$ref": "#/$defs/occurrenceRelationPosition"}
      }
    },
    "occurrenceRelationPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fen", "ply", "scope"],
      "properties": {
        "fen": {"$ref": "#/$defs/nonEmptyString"},
        "ply": {"type": "integer", "minimum": 1},
        "scope": {"const": "legal_line"}
      }
    },
    "boundedCausalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "provenance", "ply", "move_uci", "fen_before", "fen_after"],
      "properties": {
        "step_index": {"type": "integer", "minimum": 0},
        "provenance": {"enum": ["observed_game_move", "certified_analysis_move"]},
        "ply": {"type": "integer", "minimum": 1},
        "move_uci": {"$ref": "#/$defs/uciMove"},
        "fen_before": {"$ref": "#/$defs/nonEmptyString"},
        "fen_after": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "boundedCausalMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "from", "to", "piece_before", "piece_after"],
      "properties": {
        "side": {"enum": ["white", "black"]},
        "from": {"type": "string", "pattern": "^[a-h][1-8]$"},
        "to": {"type": "string", "pattern": "^[a-h][1-8]$"},
        "piece_before": {"$ref": "#/$defs/pieceRole"},
        "piece_after": {"$ref": "#/$defs/pieceRole"}
      }
    },
    "boundedCausalPiece": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "piece", "square"],
      "properties": {
        "side": {"enum": ["white", "black"]},
        "piece": {"$ref": "#/$defs/pieceRole"},
        "square": {"type": "string", "pattern": "^[a-h][1-8]$"}
      }
    }
  }
}
