{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-v6/move-meaning-response.schema.json",
  "title": "Chesstory public move-meaning response v6",
  "description": "Development-only direct wire contract emitted by RuntimeProtocol for response.v6.",
  "oneOf": [
    {"$ref": "#/$defs/errorResponse"},
    {"$ref": "#/$defs/engineWorkRequiredResponse"},
    {"$ref": "#/$defs/readyResponse"}
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uciMove": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    },
    "side": {
      "enum": ["white", "black"]
    },
    "square": {
      "type": "string",
      "pattern": "^[a-h][1-8]$"
    },
    "boardFile": {
      "type": "string",
      "pattern": "^[a-h]$"
    },
    "pieceRole": {
      "enum": ["pawn", "knight", "bishop", "rook", "queen", "king"]
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "error"],
      "properties": {
        "schema_version": {"const": "chesstory.move-meaning.response.v6"},
        "request_id": {"$ref": "#/$defs/requestId"},
        "status": {"const": "error"},
        "error": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "engineWorkRequiredResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "probe_requests"],
      "properties": {
        "schema_version": {"const": "chesstory.move-meaning.response.v6"},
        "request_id": {"$ref": "#/$defs/requestId"},
        "status": {"const": "engine_work_required"},
        "probe_requests": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/probeRequest"}
        }
      }
    },
    "readyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "move_commentary"],
      "properties": {
        "schema_version": {"const": "chesstory.move-meaning.response.v6"},
        "request_id": {"$ref": "#/$defs/requestId"},
        "status": {"const": "ready"},
        "move_commentary": {"$ref": "#/$defs/moveCommentary"}
      }
    },
    "probeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fen",
        "moves",
        "depth",
        "purpose",
        "multiPv",
        "candidateMove",
        "variationHash",
        "horizon"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "fen": {"$ref": "#/$defs/nonEmptyString"},
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/uciMove"}
        },
        "depth": {"type": "integer", "minimum": 1, "maximum": 100},
        "purpose": {"const": "branch_reply"},
        "multiPv": {"const": 1},
        "candidateMove": {"$ref": "#/$defs/uciMove"},
        "variationHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "horizon": {
          "type": "string",
          "maxLength": 14,
          "pattern": "^ply:[1-9][0-9]*$"
        }
      }
    },
    "moveCommentary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "structural_idea_units"],
      "properties": {
        "primary": {"$ref": "#/$defs/primary"},
        "structural_idea_units": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/structuralIdeaUnit"}
        },
        "causal_explanations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/causalExplanation"}
        },
        "responsibility_links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/resourceLiabilityResponsibilityLink"}
        }
      }
    },
    "structuralProofSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_key", "evidence_id"],
      "properties": {
        "proof_key": {"$ref": "#/$defs/nonEmptyString"},
        "evidence_id": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "relationPiece": {
      "type": "object",
      "additionalProperties": false,
      "required": ["piece", "square"],
      "properties": {
        "piece": {"$ref": "#/$defs/pieceRole"},
        "square": {"$ref": "#/$defs/square"}
      }
    },
    "nullableRelationPiece": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/relationPiece"}
      ]
    },
    "coloredRelationPiece": {
      "type": "object",
      "additionalProperties": false,
      "required": ["piece", "square", "side"],
      "properties": {
        "piece": {"$ref": "#/$defs/pieceRole"},
        "square": {"$ref": "#/$defs/square"},
        "side": {"$ref": "#/$defs/side"}
      }
    },
    "rootMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "from", "to", "piece_before", "piece_after"],
      "properties": {
        "side": {"$ref": "#/$defs/side"},
        "from": {"$ref": "#/$defs/square"},
        "to": {"$ref": "#/$defs/square"},
        "piece_before": {"$ref": "#/$defs/pieceRole"},
        "piece_after": {"$ref": "#/$defs/pieceRole"}
      }
    },
    "controlTarget": {
      "oneOf": [
        {"$ref": "#/$defs/emptyControlTarget"},
        {"$ref": "#/$defs/friendlyControlTarget"},
        {"$ref": "#/$defs/enemyControlTarget"}
      ]
    },
    "emptyControlTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "empty"}
      }
    },
    "friendlyControlTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "piece"],
      "properties": {
        "kind": {"const": "friendly_piece"},
        "piece": {"$ref": "#/$defs/pieceRole"}
      }
    },
    "enemyControlTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "piece"],
      "properties": {
        "kind": {"const": "enemy_piece"},
        "piece": {"$ref": "#/$defs/pieceRole"}
      }
    },
    "controlReach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["square", "target"],
      "properties": {
        "square": {"$ref": "#/$defs/square"},
        "target": {"$ref": "#/$defs/controlTarget"}
      }
    },
    "relationDirection": {
      "oneOf": [
        {"$ref": "#/$defs/fileRelationDirection"},
        {"$ref": "#/$defs/rankRelationDirection"},
        {"$ref": "#/$defs/diagonalRelationDirection"}
      ]
    },
    "fileRelationDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_step", "rank_step", "axis"],
      "properties": {
        "file_step": {"const": 0},
        "rank_step": {"enum": [-1, 1]},
        "axis": {"const": "file"}
      }
    },
    "rankRelationDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_step", "rank_step", "axis"],
      "properties": {
        "file_step": {"enum": [-1, 1]},
        "rank_step": {"const": 0},
        "axis": {"const": "rank"}
      }
    },
    "diagonalRelationDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_step", "rank_step", "axis"],
      "properties": {
        "file_step": {"enum": [-1, 1]},
        "rank_step": {"enum": [-1, 1]},
        "axis": {"const": "diagonal"}
      }
    },
    "structuralSubjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding_key", "proof_sources"],
      "properties": {
        "kind": {
          "enum": [
            "open_file",
            "semi_open_file",
            "piece_at",
            "geometric_control_set_change",
            "slider_reach_change",
            "pawn_tension_created",
            "pawn_tension_resolved",
            "battery",
            "passed_pawn_created",
            "passed_pawn_lost",
            "passed_pawn_advanced",
            "passed_status_created",
            "passed_pawn_promoted"
          ]
        },
        "binding_key": {"$ref": "#/$defs/nonEmptyString"},
        "proof_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/structuralProofSource"}
        },
        "side": {"$ref": "#/$defs/side"},
        "file": {"$ref": "#/$defs/boardFile"},
        "square": {"$ref": "#/$defs/square"},
        "piece": {"$ref": "#/$defs/pieceRole"},
        "root_movement": {"$ref": "#/$defs/rootMovement"},
        "controlling_side": {"$ref": "#/$defs/side"},
        "target_square": {"$ref": "#/$defs/square"},
        "before_target": {"$ref": "#/$defs/controlTarget"},
        "after_target": {"$ref": "#/$defs/controlTarget"},
        "before_controllers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relationPiece"}
        },
        "after_controllers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relationPiece"}
        },
        "removed_controllers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relationPiece"}
        },
        "established_controllers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relationPiece"}
        },
        "slider_before": {"$ref": "#/$defs/nullableRelationPiece"},
        "slider_after": {"$ref": "#/$defs/nullableRelationPiece"},
        "direction": {"$ref": "#/$defs/relationDirection"},
        "gained": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/controlReach"}
        },
        "lost": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/controlReach"}
        },
        "from": {"$ref": "#/$defs/square"},
        "to": {"$ref": "#/$defs/square"},
        "axis": {"enum": ["file", "rank", "diagonal"]},
        "pieces": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/coloredRelationPiece"}
        },
        "relative_rank": {"type": "integer", "minimum": 1, "maximum": 8}
      },
      "oneOf": [
        {
          "required": ["kind", "binding_key", "proof_sources", "file"],
          "maxProperties": 4,
          "properties": {"kind": {"const": "open_file"}}
        },
        {
          "required": ["kind", "binding_key", "proof_sources", "side", "file"],
          "maxProperties": 5,
          "properties": {"kind": {"const": "semi_open_file"}}
        },
        {
          "required": ["kind", "binding_key", "proof_sources", "side", "piece", "square"],
          "maxProperties": 6,
          "properties": {"kind": {"const": "piece_at"}}
        },
        {
          "required": [
            "kind",
            "binding_key",
            "proof_sources",
            "root_movement",
            "controlling_side",
            "target_square",
            "before_target",
            "after_target",
            "before_controllers",
            "after_controllers",
            "removed_controllers",
            "established_controllers"
          ],
          "maxProperties": 12,
          "properties": {"kind": {"const": "geometric_control_set_change"}}
        },
        {
          "required": [
            "kind",
            "binding_key",
            "proof_sources",
            "side",
            "slider_before",
            "slider_after",
            "direction",
            "gained",
            "lost"
          ],
          "maxProperties": 9,
          "properties": {"kind": {"const": "slider_reach_change"}},
          "not": {
            "required": ["slider_before", "slider_after"],
            "properties": {
              "slider_before": {"type": "null"},
              "slider_after": {"type": "null"}
            }
          },
          "anyOf": [
            {"properties": {"gained": {"minItems": 1}}},
            {"properties": {"lost": {"minItems": 1}}}
          ]
        },
        {
          "required": ["kind", "binding_key", "proof_sources", "side", "piece", "from", "to"],
          "maxProperties": 7,
          "properties": {
            "kind": {"const": "pawn_tension_created"},
            "piece": {"const": "pawn"}
          }
        },
        {
          "required": ["kind", "binding_key", "proof_sources", "side", "piece", "from", "to"],
          "maxProperties": 7,
          "properties": {
            "kind": {"const": "pawn_tension_resolved"},
            "piece": {"const": "pawn"}
          }
        },
        {
          "required": ["kind", "binding_key", "proof_sources", "side", "axis", "pieces"],
          "maxProperties": 6,
          "properties": {"kind": {"const": "battery"}}
        },
        {
          "required": ["kind", "binding_key", "proof_sources", "side", "piece", "square"],
          "maxProperties": 6,
          "properties": {
            "kind": {"const": "passed_pawn_created"},
            "piece": {"const": "pawn"}
          }
        },
        {
          "required": ["kind", "binding_key", "proof_sources", "side", "piece", "square"],
          "maxProperties": 6,
          "properties": {
            "kind": {"const": "passed_pawn_lost"},
            "piece": {"const": "pawn"}
          }
        },
        {
          "required": [
            "kind",
            "binding_key",
            "proof_sources",
            "side",
            "piece",
            "from",
            "to",
            "relative_rank"
          ],
          "maxProperties": 8,
          "properties": {
            "kind": {"const": "passed_pawn_advanced"},
            "piece": {"const": "pawn"}
          }
        },
        {
          "required": [
            "kind",
            "binding_key",
            "proof_sources",
            "side",
            "piece",
            "from",
            "to",
            "relative_rank"
          ],
          "maxProperties": 8,
          "properties": {
            "kind": {"const": "passed_status_created"},
            "piece": {"const": "pawn"}
          }
        },
        {
          "required": ["kind", "binding_key", "proof_sources", "side", "piece", "from", "to"],
          "maxProperties": 7,
          "properties": {
            "kind": {"const": "passed_pawn_promoted"},
            "piece": {"const": "pawn"}
          }
        }
      ]
    },
    "structuralIdeaUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_evidence_id",
        "consequence_index",
        "line_id",
        "root_move",
        "consequence_kind",
        "consequence_key",
        "polarity",
        "state_direction",
        "strength",
        "subjects",
        "targets"
      ],
      "properties": {
        "structural_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "consequence_index": {"type": "integer", "minimum": 0},
        "line_id": {"$ref": "#/$defs/nonEmptyString"},
        "root_move": {"$ref": "#/$defs/uciMove"},
        "consequence_kind": {
          "enum": [
            "open_file_established",
            "semi_open_file_established",
            "geometric_control_set_changed",
            "pawn_tension_created",
            "pawn_tension_resolution",
            "passed_pawn_progress",
            "passed_pawn_concession",
            "battery_formation",
            "slider_reach_changed"
          ]
        },
        "consequence_key": {"$ref": "#/$defs/nonEmptyString"},
        "polarity": {"enum": ["gain", "loss", "neutral"]},
        "state_direction": {"enum": ["established", "removed", "changed"]},
        "strength": {"type": "integer"},
        "subjects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/structuralSubjectBinding"}
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/structuralSubjectBinding"}
        }
      },
      "anyOf": [
        {"properties": {"subjects": {"minItems": 1}}},
        {"properties": {"targets": {"minItems": 1}}}
      ],
      "oneOf": [
        {
          "properties": {
            "consequence_kind": {
              "enum": [
                "open_file_established",
                "semi_open_file_established",
                "pawn_tension_created",
                "battery_formation"
              ]
            },
            "polarity": {"const": "neutral"},
            "state_direction": {"const": "established"}
          }
        },
        {
          "properties": {
            "consequence_kind": {"const": "pawn_tension_resolution"},
            "polarity": {"const": "neutral"},
            "state_direction": {"const": "removed"}
          }
        },
        {
          "properties": {
            "consequence_kind": {"const": "passed_pawn_progress"},
            "polarity": {"const": "gain"},
            "state_direction": {"const": "established"}
          }
        },
        {
          "properties": {
            "consequence_kind": {"const": "passed_pawn_concession"},
            "polarity": {"const": "loss"},
            "state_direction": {"const": "removed"}
          }
        },
        {
          "properties": {
            "consequence_kind": {
              "enum": ["geometric_control_set_changed", "slider_reach_changed"]
            },
            "polarity": {"const": "neutral"},
            "state_direction": {"const": "changed"}
          }
        }
      ]
    },
    "primary": {
      "oneOf": [
        {"$ref": "#/$defs/moveVerdictPrimary"},
        {"$ref": "#/$defs/bestChoicePrimary"}
      ]
    },
    "verdictCode": {
      "enum": [
        "improves_on_reference",
        "matches_reference",
        "playable_loss",
        "inaccuracy",
        "mistake",
        "blunder"
      ]
    },
    "verdictConfidence": {
      "enum": ["engine_backed", "legal_replay_verified", "mixed_verified"]
    },
    "comparisonDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidate_win_percent_delta_for_mover"],
      "properties": {
        "kind": {"enum": ["engine_evaluation", "outcome_only"]},
        "candidate_win_percent_delta_for_mover": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "moveVerdictPrimary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "comparison_evidence_id",
        "verdict_code",
        "verdict_confidence",
        "mover",
        "delta",
        "reference_endpoint",
        "played_endpoint",
        "presentation"
      ],
      "properties": {
        "kind": {"const": "move_verdict"},
        "comparison_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "verdict_code": {"$ref": "#/$defs/verdictCode"},
        "verdict_confidence": {"$ref": "#/$defs/verdictConfidence"},
        "mover": {"enum": ["white", "black"]},
        "delta": {"$ref": "#/$defs/comparisonDelta"},
        "reference_endpoint": {"$ref": "#/$defs/endpoint"},
        "played_endpoint": {"$ref": "#/$defs/endpoint"},
        "presentation": {"$ref": "#/$defs/nonEmptyString"}
      },
      "oneOf": [
        {
          "properties": {
            "verdict_confidence": {"const": "engine_backed"},
            "delta": {"properties": {"kind": {"const": "engine_evaluation"}}},
            "reference_endpoint": {"$ref": "#/$defs/engineEndpoint"},
            "played_endpoint": {"$ref": "#/$defs/engineEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "legal_replay_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "reference_endpoint": {"$ref": "#/$defs/terminalEndpoint"},
            "played_endpoint": {"$ref": "#/$defs/terminalEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "mixed_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "reference_endpoint": {"$ref": "#/$defs/engineEndpoint"},
            "played_endpoint": {"$ref": "#/$defs/terminalEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "mixed_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "reference_endpoint": {"$ref": "#/$defs/terminalEndpoint"},
            "played_endpoint": {"$ref": "#/$defs/engineEndpoint"}
          }
        }
      ]
    },
    "bestChoicePrimary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "comparison_evidence_id",
        "runner_up_verdict_code",
        "verdict_confidence",
        "mover",
        "delta",
        "best_endpoint",
        "runner_up_endpoint",
        "candidate_set",
        "presentation"
      ],
      "properties": {
        "kind": {"const": "best_choice"},
        "comparison_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "runner_up_verdict_code": {"$ref": "#/$defs/verdictCode"},
        "verdict_confidence": {"$ref": "#/$defs/verdictConfidence"},
        "mover": {"enum": ["white", "black"]},
        "delta": {"$ref": "#/$defs/comparisonDelta"},
        "best_endpoint": {"$ref": "#/$defs/endpoint"},
        "runner_up_endpoint": {"$ref": "#/$defs/endpoint"},
        "candidate_set": {"$ref": "#/$defs/candidateSet"},
        "presentation": {"$ref": "#/$defs/nonEmptyString"}
      },
      "oneOf": [
        {
          "properties": {
            "verdict_confidence": {"const": "engine_backed"},
            "delta": {"properties": {"kind": {"const": "engine_evaluation"}}},
            "best_endpoint": {"$ref": "#/$defs/engineEndpoint"},
            "runner_up_endpoint": {"$ref": "#/$defs/engineEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "legal_replay_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "best_endpoint": {"$ref": "#/$defs/terminalEndpoint"},
            "runner_up_endpoint": {"$ref": "#/$defs/terminalEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "mixed_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "best_endpoint": {"$ref": "#/$defs/engineEndpoint"},
            "runner_up_endpoint": {"$ref": "#/$defs/terminalEndpoint"}
          }
        },
        {
          "properties": {
            "verdict_confidence": {"const": "mixed_verified"},
            "delta": {"properties": {"kind": {"const": "outcome_only"}}},
            "best_endpoint": {"$ref": "#/$defs/terminalEndpoint"},
            "runner_up_endpoint": {"$ref": "#/$defs/engineEndpoint"}
          }
        }
      ]
    },
    "candidateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["only_move", "narrow_choice", "style_choice"]}
      }
    },
    "endpoint": {
      "oneOf": [
        {"$ref": "#/$defs/engineEndpoint"},
        {"$ref": "#/$defs/terminalEndpoint"}
      ]
    },
    "engineEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "moves", "win_percent_for_mover", "depth"],
      "properties": {
        "kind": {"const": "engine_search"},
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/uciMove"}
        },
        "win_percent_for_mover": {"type": "number", "minimum": 0, "maximum": 100},
        "depth": {"type": "integer", "minimum": 0, "maximum": 100},
        "mate_forecast_white_pov": {"$ref": "#/$defs/nonZeroInteger"}
      },
      "oneOf": [
        {
          "required": ["mate_forecast_white_pov"]
        },
        {
          "not": {"required": ["mate_forecast_white_pov"]},
          "properties": {
            "depth": {"type": "integer", "minimum": 8, "maximum": 100}
          }
        }
      ]
    },
    "terminalEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "moves", "terminal"],
      "properties": {
        "kind": {"const": "exact_automatic_terminal"},
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/uciMove"}
        },
        "terminal": {"$ref": "#/$defs/automaticTerminal"}
      }
    },
    "nonZeroInteger": {
      "oneOf": [
        {"type": "integer", "minimum": -1000, "maximum": -1},
        {"type": "integer", "minimum": 1, "maximum": 1000}
      ]
    },
    "automaticTerminal": {
      "oneOf": [
        {"$ref": "#/$defs/checkmateTerminal"},
        {"$ref": "#/$defs/stalemateTerminal"},
        {"$ref": "#/$defs/insufficientMaterialTerminal"},
        {"$ref": "#/$defs/fivefoldRepetitionTerminal"},
        {"$ref": "#/$defs/seventyFiveMoveRuleTerminal"}
      ]
    },
    "checkmateTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "winner"],
      "properties": {
        "kind": {"const": "checkmate"},
        "winner": {"enum": ["white", "black"]}
      }
    },
    "stalemateTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "stalemate"}
      }
    },
    "insufficientMaterialTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "insufficient_material"}
      }
    },
    "fivefoldRepetitionTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "fivefold_repetition"}
      }
    },
    "seventyFiveMoveRuleTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "seventy_five_move_rule"}
      }
    },
    "causalExplanation": {
      "oneOf": [
        {"$ref": "#/$defs/singleCauseExplanation"},
        {"$ref": "#/$defs/exactPvbResponsibilityExplanation"}
      ]
    },
    "singleCauseExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "presentation", "facets"],
      "properties": {
        "kind": {"const": "single_cause"},
        "presentation": {"$ref": "#/$defs/nonEmptyString"},
        "facets": {"$ref": "#/$defs/singleCauseFacets"}
      }
    },
    "exactPvbResponsibilityExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "presentation", "facets"],
      "properties": {
        "kind": {"const": "exact_pvb_responsibility"},
        "presentation": {"$ref": "#/$defs/nonEmptyString"},
        "facets": {"$ref": "#/$defs/exactPvbResponsibilityFacets"}
      }
    },
    "singleCauseFacets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {"$ref": "#/$defs/leadCausalFacet"}
      ],
      "items": false
    },
    "exactPvbResponsibilityFacets": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/exactPvbLeadCausalFacet"}
      ],
      "items": {"$ref": "#/$defs/exactPvbSupportingCausalFacet"}
    },
    "leadCausalFacet": {
      "allOf": [
        {"$ref": "#/$defs/causalFacet"},
        {
          "type": "object",
          "properties": {
            "facet_role": {"const": "lead"}
          }
        }
      ]
    },
    "exactPvbLeadCausalFacet": {
      "allOf": [
        {"$ref": "#/$defs/causalFacet"},
        {
          "type": "object",
          "properties": {
            "facet_role": {"const": "lead"},
            "effect_mode": {"const": "played_liability"},
            "exposure": {"const": "primary"}
          }
        }
      ]
    },
    "exactPvbSupportingCausalFacet": {
      "allOf": [
        {"$ref": "#/$defs/causalFacet"},
        {
          "type": "object",
          "properties": {
            "facet_role": {"const": "supporting"},
            "effect_mode": {"const": "alternative_resource"},
            "exposure": {"const": "complementary"}
          }
        }
      ]
    },
    "causalFacet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet_role",
        "cause_evidence_id",
        "kind",
        "proof_confidence",
        "effect_mode",
        "exposure",
        "source_side",
        "event_move",
        "comparison_kind",
        "only_move_qualifiers",
        "channels"
      ],
      "properties": {
        "facet_role": {"enum": ["lead", "supporting"]},
        "cause_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {"$ref": "#/$defs/relativeCauseKind"},
        "proof_confidence": {
          "enum": [
            "legal_replay_verified",
            "engine_backed",
            "board_derived",
            "mixed"
          ]
        },
        "effect_mode": {
          "enum": ["played_liability", "alternative_resource", "played_value"]
        },
        "exposure": {"enum": ["primary", "complementary"]},
        "source_side": {"enum": ["reference", "candidate", "shared", "mixed"]},
        "event_move": {"$ref": "#/$defs/uciMove"},
        "comparison_kind": {
          "enum": [
            "played_vs_best",
            "best_vs_second",
            "played_vs_alternative",
            "reference_vs_alternative"
          ]
        },
        "only_move_qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/onlyMoveQualifier"}
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/causalChannel"}
        }
      }
    },
    "onlyMoveQualifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_evidence_id",
        "cause_evidence_id",
        "reference_line_id",
        "reference_line_role",
        "reference_line_rank",
        "reference_line_root_move",
        "relation"
      ],
      "properties": {
        "comparison_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "cause_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "reference_line_id": {"$ref": "#/$defs/nonEmptyString"},
        "reference_line_role": {
          "enum": ["played", "best_reference", "alternative", "threat"]
        },
        "reference_line_rank": {"type": "integer", "minimum": 1},
        "reference_line_root_move": {"$ref": "#/$defs/uciMove"},
        "relation": {"const": "same_channel_association"}
      }
    },
    "resourceLiabilityResponsibilityLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_cause_evidence_id",
        "liability_cause_evidence_ids"
      ],
      "properties": {
        "resource_cause_evidence_id": {"$ref": "#/$defs/nonEmptyString"},
        "liability_cause_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "relativeCauseKind": {
      "enum": [
        "missed_tactical_resource",
        "tactical_refutation_of_played",
        "candidate_tactical_liability",
        "recapture_recovery_window",
        "wrong_move_order",
        "tempo_loss",
        "conversion_miss",
        "conversion_secured",
        "sacrifice_compensation",
        "plan_improvement",
        "plan_contradiction",
        "defensive_resource",
        "draw_resource",
        "king_forcing",
        "material_swing"
      ]
    },
    "causalChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "causal_signature",
        "direct_change",
        "played_change",
        "actor",
        "targets",
        "mechanisms",
        "consequences",
        "witnesses",
        "proof_line_moves"
      ],
      "dependentRequired": {
        "actor": ["targets", "mechanisms", "consequences", "witnesses"],
        "targets": ["actor", "mechanisms", "consequences", "witnesses"],
        "mechanisms": ["actor", "targets", "consequences", "witnesses"],
        "consequences": ["actor", "targets", "mechanisms", "witnesses"],
        "witnesses": ["actor", "targets", "mechanisms", "consequences"]
      },
      "properties": {
        "channel_id": {"$ref": "#/$defs/nonEmptyString"},
        "causal_signature": {"$ref": "#/$defs/nonEmptyString"},
        "direct_change": {
          "enum": ["occurred", "prevented", "maintained", "lost", "refuted", "missed"]
        },
        "played_change": {
          "enum": ["occurred", "prevented", "maintained", "lost", "refuted", "missed"]
        },
        "actor": {"$ref": "#/$defs/causalActor"},
        "targets": {"$ref": "#/$defs/chessObjects"},
        "mechanisms": {"$ref": "#/$defs/chessObjects"},
        "consequences": {"$ref": "#/$defs/chessObjects"},
        "witnesses": {"$ref": "#/$defs/chessObjects"},
        "proof_line_moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/uciMove"}
        },
        "horizon": {"$ref": "#/$defs/nonEmptyString"},
        "proof_segment": {"$ref": "#/$defs/directCauseProofSegment"}
      }
    },
    "causalActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["move_uci", "side", "piece", "from", "to"],
      "properties": {
        "move_uci": {"$ref": "#/$defs/uciMove"},
        "side": {"enum": ["white", "black"]},
        "piece": {"$ref": "#/$defs/nonEmptyString"},
        "from": {"type": "string", "pattern": "^[a-h][1-8]$"},
        "to": {"type": "string", "pattern": "^[a-h][1-8]$"}
      }
    },
    "chessObjects": {
      "type": "array",
      "items": {"$ref": "#/$defs/chessObject"}
    },
    "chessObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key"],
      "properties": {
        "kind": {
          "enum": [
            "move",
            "piece",
            "side",
            "square",
            "file",
            "pawn",
            "plan_subject",
            "relation",
            "line",
            "mechanism",
            "consequence"
          ]
        },
        "key": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "directCauseProofSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_relation", "steps"],
      "properties": {
        "terminal_relation": {
          "enum": [
            "produces_line_consequence",
            "is_root_line_event",
            "instantiates_relation",
            "realizes_plan_result"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {"$ref": "#/$defs/directCauseProofStep"}
        }
      }
    },
    "directCauseProofStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ply_offset", "move_uci", "role"],
      "properties": {
        "ply_offset": {"type": "integer", "minimum": 0, "maximum": 79},
        "move_uci": {"$ref": "#/$defs/uciMove"},
        "role": {"enum": ["root_action", "causal_link", "terminal_event"]},
        "plan_event": {"$ref": "#/$defs/directCausePlanEventOccurrence"}
      }
    },
    "directCausePlanEventOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_kind",
        "actor_side",
        "actor_role",
        "actor_after_role",
        "actor_from",
        "actor_to",
        "legal_move_relation"
      ],
      "properties": {
        "goal_kind": {"enum": ["passer_conversion", "passed_pawn_manufacture"]},
        "actor_side": {"$ref": "#/$defs/side"},
        "actor_role": {"$ref": "#/$defs/pieceRole"},
        "actor_after_role": {"$ref": "#/$defs/pieceRole"},
        "actor_from": {"$ref": "#/$defs/square"},
        "actor_to": {"$ref": "#/$defs/square"},
        "legal_move_relation": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
