{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/cause-audit-v2/judgment.schema.json",
  "title": "Per-case cause audit judgment without oracle prose disclosure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "partition",
    "answerable",
    "status",
    "oracle_label_sha256",
    "actual_view_sha256",
    "runtime_status",
    "cause_match",
    "cascade",
    "errors",
    "first_failure_stage"
  ],
  "properties": {
    "schema_version": {"const": "chesstory.eval.cause-audit-judgment.v2"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "partition": {"enum": ["explore", "sealed_confirm"]},
    "answerable": {"type": "boolean"},
    "status": {"enum": ["matched", "mismatch", "unanswerable", "runtime_unavailable"]},
    "oracle_label_sha256": {"$ref": "#/$defs/sha256"},
    "actual_view_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_status": {"enum": ["complete", "unavailable", "adapter_error"]},
    "cause_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_kind_count",
        "root_aligned_cause_count",
        "matched_cause_count",
        "matched_cause_record_ids",
        "forbidden_cause_count",
        "competing_ranked_cause_count",
        "object_tuple_assessment",
        "attribution_semantic_assessment"
      ],
      "properties": {
        "expected_kind_count": {"type": "integer", "minimum": 0},
        "root_aligned_cause_count": {"type": "integer", "minimum": 0},
        "matched_cause_count": {"type": "integer", "minimum": 0},
        "matched_cause_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_cause_count": {"type": "integer", "minimum": 0},
        "competing_ranked_cause_count": {"type": "integer", "minimum": 0},
        "object_tuple_assessment": {"const": "structural-completeness-only"},
        "attribution_semantic_assessment": {"const": "not-performed-no-typed-oracle-polarity"}
      }
    },
    "cascade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c", "jp", "ja", "r", "packet", "p"],
      "properties": {
        "c": {"type": "integer", "minimum": 0},
        "jp": {"type": "integer", "minimum": 0},
        "ja": {"type": "integer", "minimum": 0},
        "r": {"type": "integer", "minimum": 0},
        "packet": {"type": "integer", "minimum": 0},
        "p": {"type": "integer", "minimum": 0}
      }
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "x-canonical": {"mode": "unordered-set"},
      "items": {
        "enum": [
          "runtime_unavailable",
          "missing_cause",
          "wrong_cause_kind",
          "wrong_cause_source",
          "wrong_attribution",
          "forbidden_cause_emitted",
          "generic_fallback_takeover",
          "priority_inversion",
          "missing_actor_binding",
          "missing_target_binding",
          "missing_mechanism_binding",
          "missing_consequence_binding",
          "jp_loss",
          "ja_loss",
          "r_loss",
          "packet_loss",
          "projection_set_mismatch",
          "p_loss"
        ]
      }
    },
    "first_failure_stage": {"enum": ["C", "Jp", "Ja", "R", "P", null]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
