{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-commentary-v4/position-commentary-job-request.schema.json",
  "title": "Chesstory position commentary job request v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_profile", "request_id", "initial_fen", "move_prefix_uci", "current_fen"],
  "properties": {
    "schema_version": {"const": "chesstory.position-commentary.job-request.v4"},
    "engine_profile": {"const": "sf18-smallnet-t2-h16-v1"},
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "initial_fen": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "move_prefix_uci": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"}
    },
    "current_fen": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
