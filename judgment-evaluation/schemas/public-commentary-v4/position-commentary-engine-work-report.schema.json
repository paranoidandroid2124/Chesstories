{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-commentary-v4/position-commentary-engine-work-report.schema.json",
  "title": "Chesstory position commentary engine work report v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_profile", "work_id", "outcome"],
  "properties": {
    "schema_version": {"const": "chesstory.position-commentary.engine-work-report.v4"},
    "engine_profile": {"const": "sf18-smallnet-t2-h16-v1"},
    "work_id": {"type": "string", "pattern": "^work:[0-9]+$"},
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "line_suffixes"],
          "properties": {
            "kind": {"const": "completed"},
            "line_suffixes": {
              "description": "The exact issued MultiPV count; when more than one line is issued, their first moves are distinct.",
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["moves", "depth", "white_score"],
                "properties": {
                  "moves": {
                    "description": "Lowercase UCI suffix moves from the issued search_fen.",
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 80,
                    "items": {"type": "string", "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"}
                  },
                  "depth": {
                    "description": "Search depth meeting the required depth of the issued work.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "white_score": {
                    "description": "Browser engine score from White's perspective.",
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "value"],
                        "properties": {
                          "kind": {"const": "cp"},
                          "value": {"type": "integer", "minimum": -100000, "maximum": 100000}
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "value"],
                        "properties": {
                          "kind": {"const": "mate"},
                          "value": {
                            "oneOf": [
                              {"type": "integer", "minimum": -1000, "maximum": -1},
                              {"type": "integer", "minimum": 1, "maximum": 1000}
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"const": "executor_failed"}
          }
        }
      ]
    }
  }
}
