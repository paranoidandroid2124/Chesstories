{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-commentary-v4/position-commentary-response.schema.json",
  "title": "Chesstory completed position commentary response v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_profile", "request_id", "current_fen", "result"],
  "properties": {
    "schema_version": {"const": "chesstory.position-commentary.response.v4"},
    "engine_profile": {"const": "sf18-smallnet-t2-h16-v1"},
    "request_id": {"$ref": "#/$defs/requestId"},
    "current_fen": {"type": "string", "minLength": 1, "maxLength": 128},
    "result": {"$ref": "#/$defs/positionResult"}
  },
  "$defs": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uciMove": {
      "type": "string",
      "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
    },
    "positionResult": {
      "oneOf": [
        {"$ref": "#/$defs/automaticTerminalResult"},
        {"$ref": "#/$defs/forcedSingleMoveResult"},
        {"$ref": "#/$defs/drawClaimActionResult"},
        {"$ref": "#/$defs/moveChoicesResult"}
      ]
    },
    "automaticTerminalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "terminal", "presentation"],
      "properties": {
        "kind": {"const": "automatic_terminal"},
        "terminal": {"$ref": "../public-v4/move-meaning-response.schema.json#/$defs/automaticTerminal"},
        "presentation": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "forcedSingleMoveResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "move_uci", "supporting_endpoint", "presentation"],
      "properties": {
        "kind": {"const": "forced_single_move"},
        "move_uci": {"$ref": "#/$defs/uciMove"},
        "supporting_endpoint": {"$ref": "../public-v4/move-meaning-response.schema.json#/$defs/endpoint"},
        "presentation": {"$ref": "#/$defs/nonEmptyString"},
        "draw_claims": {"$ref": "#/$defs/drawClaims"}
      }
    },
    "drawClaimActionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "claims", "presentation"],
      "properties": {
        "kind": {"const": "draw_claim_action"},
        "claims": {"$ref": "#/$defs/drawClaims"},
        "presentation": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "moveChoicesResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "move_commentaries"],
      "oneOf": [
        {"required": ["draw_claims", "presentation"]},
        {
          "not": {
            "anyOf": [
              {"required": ["draw_claims"]},
              {"required": ["presentation"]}
            ]
          }
        }
      ],
      "properties": {
        "kind": {"const": "move_choices"},
        "move_commentaries": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/moveCommentaryRecord"}
        },
        "draw_claims": {"$ref": "#/$defs/drawClaims"},
        "presentation": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "moveCommentaryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_move_index", "move_uci", "commentary"],
      "properties": {
        "legal_move_index": {"type": "integer", "minimum": 0},
        "move_uci": {"$ref": "#/$defs/uciMove"},
        "commentary": {"$ref": "../public-v4/move-meaning-response.schema.json#/$defs/moveCommentary"}
      }
    },
    "drawClaims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/drawClaim"}
    },
    "drawClaim": {
      "oneOf": [
        {"$ref": "#/$defs/drawClaimAvailableNow"},
        {"$ref": "#/$defs/drawClaimByDeclaredMove"}
      ]
    },
    "drawClaimRule": {
      "enum": ["threefold_repetition", "fifty_move_rule"]
    },
    "drawClaimAvailableNow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "availability"],
      "properties": {
        "rule": {"$ref": "#/$defs/drawClaimRule"},
        "availability": {"const": "available_now"}
      }
    },
    "drawClaimByDeclaredMove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "availability", "move_ucis"],
      "properties": {
        "rule": {"$ref": "#/$defs/drawClaimRule"},
        "availability": {"const": "available_by_declared_move"},
        "move_ucis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uciMove"}
        }
      }
    }
  }
}
