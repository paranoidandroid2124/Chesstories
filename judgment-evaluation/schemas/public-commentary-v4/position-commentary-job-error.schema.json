{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesstories.dev/judgment-evaluation/schemas/public-commentary-v4/position-commentary-job-error.schema.json",
  "title": "Chesstory position commentary job error v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "error"],
  "properties": {
    "schema_version": {"const": "chesstory.position-commentary.job-error.v4"},
    "engine_profile": {"const": "sf18-smallnet-t2-h16-v1"},
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32}$"
    },
    "error": {"type": "string", "minLength": 1}
  }
}
